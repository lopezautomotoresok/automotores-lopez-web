---
import { autos } from '../../data/autos.js';
import '../../styles/global.css';

export function getStaticPaths() {
  return autos.map((auto) => ({ params: { id: auto.id }, props: { auto } }));
}

const { auto } = Astro.props;
const formatPrice = (value) => value > 0 ? `$${value.toLocaleString('es-AR')}` : 'Consultar';
const formatKm = (value) => `${value.toLocaleString('es-AR')} km`;
const whatsapp = `https://wa.me/543513489872?text=${encodeURIComponent(`Hola, estoy consultando por la ${auto.marca} ${auto.modelo} ${auto.anio} que vi en la web.`)}`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={`${auto.marca} ${auto.modelo} ${auto.anio} - Automotores Lopez`} />
    <title>{auto.marca} {auto.modelo} | Automotores Lopez</title>
  </head>
  <body>
    <header class="header">
      <div class="container nav">
        <a class="brand" href="/">LOPEZ<span>.</span></a>
        <nav class="navlinks"><a href="/#vehiculos">Vehículos</a><a href="/#contacto">Contacto</a></nav>
        <a class="cta" href={whatsapp} target="_blank" rel="noreferrer">WhatsApp</a>
      </div>
    </header>

    <main class="detail-page">
      <div class="container">
        <a class="back-link" href="/#vehiculos">← Volver al catálogo</a>
        <div class="detail-grid">
          <section>
            <img id="main-image" class="main-image" src={auto.imagenes[0]} alt={`${auto.marca} ${auto.modelo}`} />
            <div class="thumbs">
              {auto.imagenes.map((img, i) => <button class="thumb" data-src={img} aria-label={`Ver foto ${i+1}`}><img src={img} alt="" /></button>)}
            </div>
          </section>
          <aside class="detail-card">
            {auto.destacado && <div class="badge">DESTACADO</div>}
            <div class="eyebrow">{auto.marca.toUpperCase()}</div>
            <h1>{auto.modelo}</h1>
            <div class="detail-price">{formatPrice(auto.precio)}</div>
            <div class="facts">
              <div><span>Año</span><strong>{auto.anio}</strong></div>
              <div><span>Kilometraje</span><strong>{formatKm(auto.km)}</strong></div>
              <div><span>Combustible</span><strong>{auto.combustible}</strong></div>
              <div><span>Transmisión</span><strong>{auto.transmision}</strong></div>
              <div><span>Tracción</span><strong>{auto.traccion}</strong></div>
              <div><span>Color</span><strong>{auto.color}</strong></div>
            </div>
            <a class="cta detail-cta" href={whatsapp} target="_blank" rel="noreferrer">Consultar por WhatsApp</a>
          </aside>
        </div>

        <section class="spec-sections">
          <div class="spec-block"><h2>Motor y mecánica</h2><ul>{auto.motor.map(item => <li>{item}</li>)}</ul></div>
          <div class="spec-block"><h2>Dimensiones y capacidades</h2><ul>{auto.dimensiones.map(item => <li>{item}</li>)}</ul></div>
          <div class="spec-block"><h2>Confort y tecnología</h2><ul>{auto.confort.map(item => <li>{item}</li>)}</ul></div>
          <div class="spec-block"><h2>Seguridad</h2><ul>{auto.seguridad.map(item => <li>{item}</li>)}</ul></div>
        </section>
      </div>
    </main>

    <footer id="contacto" class="footer"><div class="container">Automotores Lopez · Villa Allende, Córdoba</div></footer>

    <script>
      const main = document.querySelector('#main-image');
      document.querySelectorAll('.thumb').forEach((button) => {
        button.addEventListener('click', () => { main.src = button.dataset.src; });
      });
    </script>
  </body>
</html>
