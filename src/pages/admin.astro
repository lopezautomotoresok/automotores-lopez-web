---
const pageTitle = 'Administración · Lopez Automotores';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{pageTitle}</title>
    <style>
      :root { color-scheme: dark; --bg:#08090a; --panel:#111315; --panel2:#17191c; --line:#292c31; --txt:#f5f5f5; --muted:#a2a7ae; --red:#e1192d; --green:#25d366; }
      * { box-sizing:border-box; }
      body { margin:0; background:var(--bg); color:var(--txt); font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
      button,input,select,textarea { font:inherit; }
      button { cursor:pointer; }
      .shell { min-height:100vh; }
      .topbar { min-height:76px; border-bottom:1px solid var(--line); display:flex; align-items:center; justify-content:space-between; gap:20px; padding:14px clamp(18px,4vw,54px); background:#0b0c0e; position:sticky; top:0; z-index:30; }
      .brand { display:flex; align-items:center; gap:14px; min-width:0; }
      .brand img { width:190px; max-width:48vw; height:auto; display:block; }
      .brand small { color:var(--muted); white-space:nowrap; }
      .top-actions { display:flex; align-items:center; gap:10px; }
      .btn { border:1px solid var(--line); background:var(--panel2); color:var(--txt); min-height:44px; padding:0 18px; border-radius:12px; font-weight:800; display:inline-flex; align-items:center; justify-content:center; gap:8px; text-decoration:none; }
      .btn:hover { border-color:#454a52; }
      .btn-red { background:var(--red); border-color:var(--red); color:white; }
      .btn-green { background:var(--green); border-color:var(--green); color:#06140b; }
      .btn-danger { background:#2a0d11; border-color:#5f1822; color:#ff6676; }
      .btn-small { min-height:36px; border-radius:9px; padding:0 12px; font-size:13px; }
      main { width:min(1280px,calc(100% - 40px)); margin:0 auto; padding:30px 0 70px; }
      .login-wrap { max-width:470px; margin:9vh auto 0; }
      .card { background:linear-gradient(180deg,#15171a,#101214); border:1px solid var(--line); border-radius:20px; padding:24px; }
      h1,h2,h3,p { margin-top:0; }
      h1 { font-size:clamp(28px,4vw,42px); margin-bottom:7px; }
      .muted { color:var(--muted); }
      .login-form { display:grid; gap:15px; margin-top:26px; }
      label { display:grid; gap:7px; font-size:12px; letter-spacing:.08em; text-transform:uppercase; font-weight:800; color:#c7cbd1; }
      input,select,textarea { width:100%; color:var(--txt); background:#0d0f11; border:1px solid #30343a; border-radius:11px; min-height:45px; padding:10px 12px; outline:none; }
      input:focus,select:focus,textarea:focus { border-color:#656b75; box-shadow:0 0 0 3px rgba(255,255,255,.04); }
      textarea { min-height:110px; resize:vertical; line-height:1.45; }
      .status { min-height:22px; margin-top:12px; font-size:14px; }
      .status.error { color:#ff7483; }
      .status.ok { color:#57df92; }
      .hidden { display:none !important; }
      .dash-head { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-bottom:22px; padding:0 2px; }
      .dash-head p { margin-bottom:0; }
      .vehicle-list { display:flex; flex-direction:column; gap:10px; }
      .vehicle-card { overflow:hidden; padding:0 !important; border-radius:14px; display:grid !important; grid-template-columns:150px minmax(0,1fr) auto !important; align-items:stretch; min-height:104px; max-height:112px; width:100%; }
      .vehicle-thumb { width:150px; min-width:150px; height:100%; min-height:104px; background:#090a0b center/cover no-repeat; border-right:1px solid var(--line); }
      .vehicle-card > img { display:none !important; }
      .vehicle-card-body { padding:12px 14px; min-width:0; display:grid; grid-template-columns:minmax(0,1fr) auto; grid-template-areas:'badges actions' 'title actions' 'meta actions'; column-gap:18px; align-content:center; align-items:center; }
      .vehicle-card h3 { grid-area:title; margin:2px 0 5px; font-size:17px; line-height:1.2; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
      .meta { grid-area:meta; color:var(--muted); font-size:12px; line-height:1.45; margin:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
      .badges { grid-area:badges; display:flex; flex-wrap:wrap; gap:6px; margin:0 0 3px; }
      .vehicle-card .badge { padding:4px 7px; font-size:10px; }
      .vehicle-card .vehicle-actions { grid-area:actions; gap:6px; flex-wrap:nowrap; align-items:center; }
      .vehicle-card .vehicle-actions .btn { flex:0 0 auto; min-height:34px; padding:0 10px; font-size:11px; white-space:nowrap; }
      .photo-help { color:var(--muted); font-size:13px; margin:10px 0 0; }
      .photo-item { min-width:0; width:140px; max-width:140px; display:flex; flex-direction:column; overflow:hidden; border:1px solid #2d3035; border-radius:11px; background:#0b0d0f; }
      .photo-thumb { position:relative; width:100%; height:96px; overflow:hidden; background:#050606; }
      .photo-thumb img { width:100%; height:100%; max-width:100%; object-fit:cover; display:block; }
      .photo-primary { position:absolute; left:7px; top:7px; padding:4px 7px; border-radius:999px; background:var(--red); color:white; font-size:9px; font-weight:900; letter-spacing:.04em; box-shadow:0 3px 10px rgba(0,0,0,.3); }
      .photo-tools { display:grid; grid-template-columns:34px 34px 1fr; gap:5px; padding:7px; background:#0b0d0f; align-items:center; }
      .photo-tools button { position:static; min-width:0; width:100%; height:30px; padding:0 7px; border-radius:7px; border:1px solid #30343a; background:#15181b; color:#f5f5f5; font-size:11px; font-weight:800; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
      .photo-tools button:hover { border-color:#555b65; }
      .photo-tools button:disabled { opacity:.28; cursor:not-allowed; }
      .photo-tools .make-primary { grid-column:3; color:#ff6273; }
      .photo-tools .remove-photo { grid-column:1/-1; color:#ff7c8a; background:#250e12; border-color:#5d2029; }
      .photo-order-note { margin-top:8px; font-size:12px; color:#8d939b; }

      .badge { border:1px solid #30343a; background:#0d0f11; border-radius:999px; padding:5px 9px; font-size:12px; color:#c8ccd1; }
      .badge.red { border-color:#69212a; color:#ff6171; background:#251014; }
      .vehicle-actions { display:flex; flex-wrap:wrap; gap:8px; }
      .empty { grid-column:1/-1; text-align:center; padding:55px 20px; color:var(--muted); }
      .form-wrap { margin:28px auto 0; max-width:1180px; }
      .form-head { display:flex; justify-content:space-between; align-items:center; gap:14px; margin-bottom:18px; }
      .form-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:15px; }
      .span-2 { grid-column:span 2; }
      .span-4 { grid-column:1/-1; }
      .checks { display:flex; flex-wrap:wrap; gap:18px; align-items:center; padding:14px 0 3px; }
      .checks label { display:flex; flex-direction:row; align-items:center; gap:8px; text-transform:none; letter-spacing:0; font-size:14px; }
      .checks input { width:18px; min-height:18px; height:18px; padding:0; }
      .section-title { grid-column:1/-1; border-top:1px solid var(--line); padding-top:21px; margin-top:8px; color:#ff4457; text-transform:uppercase; letter-spacing:.12em; font-weight:900; font-size:13px; }
      .photo-zone { border:1px dashed #464b53; background:#0c0e10; border-radius:15px; padding:18px; overflow:hidden; }
      .photo-zone input { background:transparent; border:0; padding:0; min-height:auto; }
      .photo-grid { display:flex; flex-wrap:wrap; gap:10px; margin-top:15px; align-items:flex-start; }
      .form-actions { display:flex; justify-content:flex-end; gap:10px; margin-top:22px; border-top:1px solid var(--line); padding-top:20px; }
      .loading { opacity:.55; pointer-events:none; }
      /* El panel usa miniaturas compactas: ninguna imagen del admin puede expandir la grilla. */
      #photoGrid img { max-width:100% !important; }
      @media (max-width:1180px) { .vehicle-card { grid-template-columns:130px minmax(0,1fr) !important; max-height:none; } .vehicle-thumb { width:130px; min-width:130px; min-height:108px; } .vehicle-card-body { grid-template-columns:1fr; grid-template-areas:'badges' 'title' 'meta' 'actions'; row-gap:5px; } .vehicle-card .vehicle-actions { margin-top:4px; } }
      @media (max-width:900px) { main { width:min(100% - 28px,1280px); } }
      @media (max-width:1050px) { .form-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .span-4 { grid-column:1/-1; } }
      @media (max-width:650px) { .topbar { min-height:64px; padding:10px 16px; } .brand img { width:145px; } .brand small { display:none; } main { width:min(100% - 20px,1280px); padding-top:22px; } .dash-head { align-items:stretch; flex-direction:column; } .vehicle-card { grid-template-columns:96px minmax(0,1fr) !important; min-height:94px; max-height:none; } .vehicle-thumb { width:96px; min-width:96px; min-height:94px; } .vehicle-card-body { padding:10px 11px; } .vehicle-card h3 { font-size:15px; } .meta { white-space:normal; font-size:11px; } .vehicle-card .vehicle-actions { overflow-x:auto; padding-bottom:2px; } .vehicle-card .vehicle-actions .btn { min-height:31px; padding:0 8px; font-size:10px; } .form-grid { grid-template-columns:1fr; } .span-2,.span-4 { grid-column:auto; } .section-title { grid-column:auto; } .photo-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; } .photo-item { width:100%; max-width:none; } .photo-thumb { height:auto; aspect-ratio:4/3; } .form-actions { flex-direction:column-reverse; } .form-actions .btn { width:100%; } }

      /* V33: respaldo responsive para dimensiones forzadas inline */
      @media (max-width:650px) {
        .vehicle-card { grid-template-columns:96px minmax(0,1fr) !important; max-height:none !important; }
        .vehicle-card > div:first-child { width:96px !important; min-width:96px !important; max-width:96px !important; height:96px !important; min-height:96px !important; max-height:96px !important; }
        .vehicle-card-body { grid-template-columns:1fr !important; grid-template-areas:'badges' 'title' 'meta' 'actions' !important; }
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <header class="topbar">
        <div class="brand">
          <a href="/" aria-label="Volver al sitio"><img src="/images/logo-lopez.png" alt="Lopez Automotores" /></a>
          <small>Panel de administración</small>
        </div>
        <div class="top-actions">
          <a class="btn btn-small" href="/" target="_blank">Ver sitio</a>
          <button id="logoutBtn" class="btn btn-small hidden" type="button">Salir</button>
        </div>
      </header>

      <main>
        <section id="loginSection" class="login-wrap">
          <div class="card">
            <p class="muted" style="text-transform:uppercase;letter-spacing:.12em;font-weight:900;font-size:12px;">Acceso privado</p>
            <h1>Administrar catálogo</h1>
            <p class="muted">Ingresá con el usuario autorizado para cargar y editar vehículos.</p>
            <form id="loginForm" class="login-form">
              <label>Email
                <input id="loginEmail" type="email" value="lopezautomotoresok@gmail.com" autocomplete="username" required />
              </label>
              <label>Contraseña
                <input id="loginPassword" type="password" autocomplete="current-password" required />
              </label>
              <button class="btn btn-red" type="submit">Ingresar</button>
            </form>
            <div id="loginStatus" class="status"></div>
          </div>
        </section>

        <section id="adminSection" class="hidden">
          <div class="dash-head">
            <div>
              <p class="muted" style="text-transform:uppercase;letter-spacing:.12em;font-weight:900;font-size:12px;">Catálogo</p>
              <h1>Vehículos</h1>
              <p class="muted">Cargá, editá o marcá unidades como vendidas.</p>
            </div>
            <button id="newVehicleBtn" class="btn btn-red" type="button">+ Agregar vehículo</button>
          </div>

          <div id="listStatus" class="status"></div>
          <div id="vehicleList" class="vehicle-list"></div>

          <section id="formSection" class="card form-wrap hidden">
            <div class="form-head">
              <div>
                <p class="muted" style="text-transform:uppercase;letter-spacing:.12em;font-weight:900;font-size:12px;">Edición</p>
                <h2 id="formTitle">Nuevo vehículo</h2>
              </div>
              <button id="closeFormBtn" class="btn btn-small" type="button">Cerrar</button>
            </div>

            <form id="vehicleForm">
              <input id="recordId" type="hidden" />
              <input id="slug" type="hidden" />
              <div class="form-grid">
                <label>Marca<input id="marca" required /></label>
                <label>Modelo<input id="modelo" required /></label>
                <label class="span-2">Versión<input id="version" /></label>
                <label>Año<input id="anio" type="number" min="1900" max="2100" /></label>
                <label>Kilometraje<input id="kilometraje" type="number" min="0" /></label>
                <label>Precio<input id="precio" type="number" min="0" placeholder="Dejar vacío para Consultar" /></label>
                <label>Color<input id="color" /></label>
                <label>Tipo<select id="tipo"><option value="">Seleccionar</option><option>SUV</option><option>Sedán</option><option>Hatchback</option><option>Pick-up</option><option>Furgón</option><option>Familiar</option><option>Coupé</option><option>Otro</option></select></label>
                <label>Combustible<select id="combustible"><option value="">Seleccionar</option><option>Nafta</option><option>Diésel</option><option>Híbrido</option><option>Eléctrico</option><option>GNC</option></select></label>
                <label>Transmisión<input id="transmision" placeholder="Ej. Automática de 9 velocidades" /></label>
                <label>Tracción<input id="traccion" placeholder="Ej. 4x4" /></label>
                <label>Carrocería<input id="carroceria" /></label>
                <label>Plazas<input id="plazas" type="number" min="1" max="20" /></label>
                <label class="span-4">Descripción<textarea id="descripcion"></textarea></label>

                <div class="span-4 checks">
                  <label><input id="publicado" type="checkbox" checked /> Publicado</label>
                  <label><input id="destacado" type="checkbox" /> Destacado</label>
                  <label><input id="vendido" type="checkbox" /> Vendido</label>
                </div>

                <div class="section-title">Ficha técnica</div>
                <label class="span-2">Motor y mecánica <span class="muted" style="text-transform:none;letter-spacing:0;font-weight:500;">Una característica por línea</span><textarea id="motor"></textarea></label>
                <label class="span-2">Dimensiones y capacidades <span class="muted" style="text-transform:none;letter-spacing:0;font-weight:500;">Una característica por línea</span><textarea id="dimensiones"></textarea></label>
                <label class="span-2">Confort y tecnología <span class="muted" style="text-transform:none;letter-spacing:0;font-weight:500;">Una característica por línea</span><textarea id="confort"></textarea></label>
                <label class="span-2">Seguridad <span class="muted" style="text-transform:none;letter-spacing:0;font-weight:500;">Una característica por línea</span><textarea id="seguridad"></textarea></label>

                <div class="section-title">Fotos</div>
                <div class="span-4 photo-zone">
                  <label style="text-transform:none;letter-spacing:0;font-size:14px;">Subir fotografías
                    <input id="photos" type="file" accept="image/jpeg,image/png,image/webp" multiple />
                  </label>
                  <p class="photo-help">La primera foto es la portada. Podés cambiarla y reordenar todas las fotos antes de guardar.</p>
                  <p class="photo-order-note">Usá ← y → para cambiar el orden. "Hacer principal" mueve esa foto al primer lugar.</p>
                  <div id="photoGrid" class="photo-grid"></div>
                </div>
              </div>

              <div class="form-actions">
                <button id="cancelBtn" class="btn" type="button">Cancelar</button>
                <button id="saveBtn" class="btn btn-red" type="submit">Guardar vehículo</button>
              </div>
              <div id="formStatus" class="status"></div>
            </form>
          </section>
        </section>
      </main>
    </div>

    <script>
      import { supabase } from '../lib/supabase.js';

      const ADMIN_EMAIL = 'lopezautomotoresok@gmail.com';
      const BUCKET = 'vehiculos';
      const $ = (id) => document.getElementById(id);
      const els = {
        loginSection:$('loginSection'), adminSection:$('adminSection'), loginForm:$('loginForm'), loginStatus:$('loginStatus'),
        logoutBtn:$('logoutBtn'), vehicleList:$('vehicleList'), listStatus:$('listStatus'), newVehicleBtn:$('newVehicleBtn'),
        formSection:$('formSection'), vehicleForm:$('vehicleForm'), formTitle:$('formTitle'), formStatus:$('formStatus'),
        closeFormBtn:$('closeFormBtn'), cancelBtn:$('cancelBtn'), photoGrid:$('photoGrid'), photos:$('photos')
      };

      let vehicles = [];
      let photoItems = []; // { kind: 'old'|'new', value: url|File }

      function setStatus(el, msg='', type='') { el.textContent = msg; el.className = `status ${type}`; }
      function slugify(value='') { return value.toString().normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim().replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,''); }
      function linesToArray(v='') { return v.split('\n').map(x=>x.trim()).filter(Boolean); }
      function arrayToLines(v) { return Array.isArray(v) ? v.join('\n') : ''; }
      function peso(v) { return v ? new Intl.NumberFormat('es-AR',{style:'currency',currency:'ARS',maximumFractionDigits:0}).format(Number(v)) : 'Consultar'; }
      function km(v) { return v === null || v === undefined ? '—' : `${new Intl.NumberFormat('es-AR').format(Number(v))} km`; }
      function escapeHtml(v='') { return String(v).replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c])); }

      async function checkSession() {
        const { data:{ session } } = await supabase.auth.getSession();
        if (session?.user?.email?.toLowerCase() === ADMIN_EMAIL) showAdmin(); else showLogin();
      }
      function showLogin() { els.loginSection.classList.remove('hidden'); els.adminSection.classList.add('hidden'); els.logoutBtn.classList.add('hidden'); }
      async function showAdmin() { els.loginSection.classList.add('hidden'); els.adminSection.classList.remove('hidden'); els.logoutBtn.classList.remove('hidden'); await loadVehicles(); }

      els.loginForm.addEventListener('submit', async (e) => {
        e.preventDefault(); setStatus(els.loginStatus,'Ingresando…');
        const email=$('loginEmail').value.trim(); const password=$('loginPassword').value;
        const { data, error } = await supabase.auth.signInWithPassword({email,password});
        if (error) return setStatus(els.loginStatus,error.message,'error');
        if (data.user?.email?.toLowerCase() !== ADMIN_EMAIL) { await supabase.auth.signOut(); return setStatus(els.loginStatus,'Este usuario no está autorizado.','error'); }
        setStatus(els.loginStatus,''); await showAdmin();
      });
      els.logoutBtn.addEventListener('click', async()=>{ await supabase.auth.signOut(); showLogin(); });

      async function loadVehicles() {
        setStatus(els.listStatus,'Cargando vehículos…');
        const { data,error } = await supabase.from('vehiculos').select('*').order('created_at',{ascending:false});
        if (error) { setStatus(els.listStatus,error.message,'error'); return; }
        vehicles=data||[]; setStatus(els.listStatus,''); renderVehicles();
      }
      function renderVehicles() {
        if (!vehicles.length) { els.vehicleList.innerHTML='<div class="card empty">Todavía no hay vehículos cargados. Tocá “Agregar vehículo”.</div>'; return; }
        els.vehicleList.innerHTML=vehicles.map(v=>{
          const img=Array.isArray(v.fotos)&&v.fotos[0]?v.fotos[0]:'/images/placeholder-car.svg';
          const safeImg = String(img).replace(/\\/g,'/').replace(/'/g,"%27");
          return `<article class="card vehicle-card" style="display:grid!important;grid-template-columns:140px minmax(0,1fr)!important;min-height:104px!important;max-height:104px!important;padding:0!important;overflow:hidden!important;border-radius:14px!important;">
            <div role="img" aria-label="${escapeHtml(`${v.marca||''} ${v.modelo||''}`)}" style="width:140px!important;height:104px!important;min-width:140px!important;min-height:104px!important;max-width:140px!important;max-height:104px!important;background-image:url('${safeImg}');background-position:center!important;background-size:cover!important;background-repeat:no-repeat!important;border-right:1px solid #292c31!important;"></div>
            <div class="vehicle-card-body" style="padding:10px 14px!important;min-width:0!important;display:grid!important;grid-template-columns:minmax(0,1fr) auto!important;grid-template-areas:'badges actions' 'title actions' 'meta actions'!important;column-gap:14px!important;align-content:center!important;">
              <div class="badges" style="grid-area:badges!important;margin:0 0 3px!important;display:flex!important;gap:6px!important;">${v.vendido?'<span class="badge red">Vendido</span>':''}${v.publicado?'<span class="badge">Publicado</span>':'<span class="badge">Oculto</span>'}${v.destacado?'<span class="badge">Destacado</span>':''}</div>
              <h3 style="grid-area:title!important;margin:2px 0 4px!important;font-size:16px!important;line-height:1.2!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important;">${escapeHtml(v.marca||'')} ${escapeHtml(v.modelo||'')}</h3>
              <div class="meta" style="grid-area:meta!important;margin:0!important;font-size:12px!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important;">${escapeHtml(v.version||'')} · ${v.anio||'—'} · ${km(v.kilometraje)} · ${peso(v.precio)}</div>
              <div class="vehicle-actions" style="grid-area:actions!important;display:flex!important;gap:6px!important;align-items:center!important;justify-content:flex-end!important;flex-wrap:wrap!important;max-width:280px!important;">
                <button class="btn btn-small" data-edit="${v.id}">Editar</button>
                <button class="btn btn-small" data-sold="${v.id}">${v.vendido?'Marcar disponible':'Marcar vendido'}</button>
                <button class="btn btn-small btn-danger" data-delete="${v.id}">Eliminar</button>
              </div>
            </div>
          </article>`;
        }).join('');
        els.vehicleList.querySelectorAll('[data-edit]').forEach(b=>b.addEventListener('click',()=>openEdit(Number(b.dataset.edit))));
        els.vehicleList.querySelectorAll('[data-sold]').forEach(b=>b.addEventListener('click',()=>toggleSold(Number(b.dataset.sold))));
        els.vehicleList.querySelectorAll('[data-delete]').forEach(b=>b.addEventListener('click',()=>deleteVehicle(Number(b.dataset.delete))));
      }

      function resetForm() {
        els.vehicleForm.reset(); $('recordId').value=''; $('slug').value=''; $('publicado').checked=true; photoItems=[]; renderPhotos(); setStatus(els.formStatus,'');
      }
      function openNew() { resetForm(); els.formTitle.textContent='Nuevo vehículo'; els.formSection.classList.remove('hidden'); els.formSection.scrollIntoView({behavior:'smooth',block:'start'}); }
      function openEdit(id) {
        const v=vehicles.find(x=>x.id===id); if(!v) return;
        resetForm(); els.formTitle.textContent=`Editar ${v.marca||''} ${v.modelo||''}`; $('recordId').value=v.id; $('slug').value=v.slug||'';
        ['marca','modelo','version','anio','kilometraje','precio','color','tipo','combustible','transmision','traccion','carroceria','plazas','descripcion'].forEach(k=>{ if($(k)) $(k).value=v[k]??''; });
        $('publicado').checked=!!v.publicado; $('destacado').checked=!!v.destacado; $('vendido').checked=!!v.vendido;
        $('motor').value=arrayToLines(v.motor); $('dimensiones').value=arrayToLines(v.dimensiones); $('confort').value=arrayToLines(v.confort); $('seguridad').value=arrayToLines(v.seguridad);
        photoItems=(Array.isArray(v.fotos)?v.fotos:[]).map(url=>({kind:'old',value:url})); renderPhotos(); els.formSection.classList.remove('hidden'); els.formSection.scrollIntoView({behavior:'smooth',block:'start'});
      }
      function closeForm() { els.formSection.classList.add('hidden'); resetForm(); }
      els.newVehicleBtn.addEventListener('click',openNew); els.closeFormBtn.addEventListener('click',closeForm); els.cancelBtn.addEventListener('click',closeForm);

      els.photos.addEventListener('change',()=>{ const files=[...els.photos.files]; photoItems.push(...files.map(file=>({kind:'new',value:file}))); els.photos.value=''; renderPhotos(); });
      function moveItem(arr, from, to) {
        if (to < 0 || to >= arr.length || from === to) return;
        const [item] = arr.splice(from, 1);
        arr.splice(to, 0, item);
      }
      function renderPhotos() {
        els.photoGrid.style.cssText='display:grid!important;grid-template-columns:repeat(auto-fill,140px)!important;gap:10px!important;align-items:start!important;justify-content:start!important;margin-top:14px!important;';
        els.photoGrid.innerHTML = photoItems.map((item,i)=>{
          const src = item.kind==='old' ? item.value : URL.createObjectURL(item.value);
          return `<div data-photo-index="${i}" style="width:140px!important;max-width:140px!important;min-width:140px!important;overflow:hidden!important;border:1px solid #2d3035!important;border-radius:10px!important;background:#0b0d0f!important;">
            <div style="position:relative!important;width:140px!important;height:92px!important;overflow:hidden!important;background:#050606!important;">
              <img src="${escapeHtml(src)}" alt="Foto ${i+1}" style="display:block!important;width:140px!important;height:92px!important;min-width:140px!important;min-height:92px!important;max-width:140px!important;max-height:92px!important;object-fit:cover!important;" />
              ${i===0?'<span class="photo-primary" style="position:absolute!important;left:6px!important;top:6px!important;">PORTADA</span>':''}
            </div>
            <div style="display:grid!important;grid-template-columns:30px 30px minmax(0,1fr)!important;gap:4px!important;padding:6px!important;">
              <button type="button" data-move-left="${i}" ${i===0?'disabled':''} style="height:28px!important;padding:0!important;">←</button>
              <button type="button" data-move-right="${i}" ${i===photoItems.length-1?'disabled':''} style="height:28px!important;padding:0!important;">→</button>
              ${i===0?'':`<button type="button" data-primary="${i}" style="height:28px!important;padding:0 5px!important;font-size:10px!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important;">Principal</button>`}
              <button type="button" data-remove="${i}" style="grid-column:1/-1!important;height:28px!important;padding:0 5px!important;font-size:10px!important;color:#ff7c8a!important;background:#250e12!important;border:1px solid #5d2029!important;border-radius:7px!important;">Quitar</button>
            </div>
          </div>`;
        }).join('');
        els.photoGrid.querySelectorAll('[data-move-left]').forEach(b=>b.addEventListener('click',()=>{ const i=Number(b.dataset.moveLeft); moveItem(photoItems,i,i-1); renderPhotos(); }));
        els.photoGrid.querySelectorAll('[data-move-right]').forEach(b=>b.addEventListener('click',()=>{ const i=Number(b.dataset.moveRight); moveItem(photoItems,i,i+1); renderPhotos(); }));
        els.photoGrid.querySelectorAll('[data-primary]').forEach(b=>b.addEventListener('click',()=>{ const i=Number(b.dataset.primary); const [item]=photoItems.splice(i,1); photoItems.unshift(item); renderPhotos(); }));
        els.photoGrid.querySelectorAll('[data-remove]').forEach(b=>b.addEventListener('click',()=>{ photoItems.splice(Number(b.dataset.remove),1); renderPhotos(); }));
      }

      async function uploadPhotosInOrder(slug) {
        const urls = [];
        let newIndex = 0;
        for (const item of photoItems) {
          if (item.kind === 'old') { urls.push(item.value); continue; }
          const file = item.value;
          const ext=(file.name.split('.').pop()||'jpg').toLowerCase();
          const path=`${slug}/${Date.now()}-${newIndex}-${slugify(file.name.replace(/\.[^.]+$/,''))}.${ext}`;
          const { error }=await supabase.storage.from(BUCKET).upload(path,file,{cacheControl:'3600',upsert:false});
          if(error) throw error;
          const { data }=supabase.storage.from(BUCKET).getPublicUrl(path);
          urls.push(data.publicUrl);
          newIndex++;
        }
        return urls;
      }

      els.vehicleForm.addEventListener('submit',async(e)=>{
        e.preventDefault(); const save=$('saveBtn'); const editingId=$('recordId').value?Number($('recordId').value):null;
        const autoSlug=$('slug').value || slugify(`${$('marca').value}-${$('modelo').value}-${$('version').value}-${$('anio').value}`);
        if(!autoSlug) return setStatus(els.formStatus,'Completá marca y modelo.','error');
        save.disabled=true; els.vehicleForm.classList.add('loading'); setStatus(els.formStatus,'Guardando…');
        try {
          const fotos=await uploadPhotosInOrder(autoSlug);
          const payload={ slug:autoSlug, marca:$('marca').value.trim(), modelo:$('modelo').value.trim(), version:$('version').value.trim()||null, anio:$('anio').value?Number($('anio').value):null, kilometraje:$('kilometraje').value?Number($('kilometraje').value):null, precio:$('precio').value?Number($('precio').value):null, moneda:'ARS', color:$('color').value.trim()||null, tipo:$('tipo').value||null, combustible:$('combustible').value||null, transmision:$('transmision').value.trim()||null, traccion:$('traccion').value.trim()||null, carroceria:$('carroceria').value.trim()||null, plazas:$('plazas').value?Number($('plazas').value):null, descripcion:$('descripcion').value.trim()||null, motor:linesToArray($('motor').value), dimensiones:linesToArray($('dimensiones').value), confort:linesToArray($('confort').value), seguridad:linesToArray($('seguridad').value), fotos, destacado:$('destacado').checked, vendido:$('vendido').checked, publicado:$('publicado').checked, updated_at:new Date().toISOString() };
          let result;
          if(editingId) result=await supabase.from('vehiculos').update(payload).eq('id',editingId);
          else result=await supabase.from('vehiculos').insert(payload);
          if(result.error) throw result.error;
          setStatus(els.formStatus,'Vehículo guardado correctamente.','ok'); photoItems=[]; await loadVehicles(); setTimeout(closeForm,650);
        } catch(err) { setStatus(els.formStatus,err?.message||'No se pudo guardar el vehículo.','error'); }
        finally { save.disabled=false; els.vehicleForm.classList.remove('loading'); }
      });

      async function toggleSold(id) {
        const v=vehicles.find(x=>x.id===id); if(!v) return;
        const {error}=await supabase.from('vehiculos').update({vendido:!v.vendido,updated_at:new Date().toISOString()}).eq('id',id);
        if(error) return alert(error.message); await loadVehicles();
      }
      async function deleteVehicle(id) {
        const v=vehicles.find(x=>x.id===id); if(!v) return;
        if(!confirm(`¿Eliminar ${v.marca||''} ${v.modelo||''}? Esta acción elimina la publicación.`)) return;
        const {error}=await supabase.from('vehiculos').delete().eq('id',id); if(error) return alert(error.message); await loadVehicles();
      }

      supabase.auth.onAuthStateChange((_event,session)=>{ if(!session) showLogin(); });
      checkSession();
    </script>
  </body>
</html>
