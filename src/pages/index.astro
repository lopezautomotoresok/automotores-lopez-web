---
import '../styles/global.css';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Catálogo de vehículos seleccionados de Automotores Lopez en Villa Allende, Córdoba." />
    <meta name="theme-color" content="#0a0a0b" />
    <title>Automotores Lopez | Vehículos seleccionados</title>

    <style>
      /* Identidad */
      .brand-logo{display:block;width:178px;flex:0 0 auto}
      .brand-logo img{display:block;width:100%;height:auto;object-fit:contain}

      /* Barra de accesos — tres bloques compactos inspirados en la referencia */
      .quick-actions-wrap{position:relative;z-index:2;margin:0;padding:0;background:#0b0b0c;border-top:1px solid rgba(255,255,255,.07);border-bottom:1px solid rgba(255,255,255,.07);overflow:hidden}
      .quick-actions-bar{background:
        radial-gradient(circle at 13% 35%, rgba(207,23,37,.14) 0 2px, transparent 3px),
        radial-gradient(circle at 82% 68%, rgba(255,255,255,.10) 0 2px, transparent 3px),
        radial-gradient(circle at 54% 18%, rgba(255,255,255,.08) 0 1.5px, transparent 2.5px),
        linear-gradient(180deg,#101012 0%,#0b0b0c 100%);
      }
      .quick-actions{width:min(1100px,calc(100% - 40px));margin:0 auto;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));}
      .quick-action{position:relative;min-height:88px;display:flex;align-items:center;justify-content:center;padding:14px 24px;background:transparent!important;border:0!important;border-right:1px solid rgba(255,255,255,.10)!important;border-radius:0!important;box-shadow:none!important;text-align:center;transition:background .18s ease}
      .quick-action:last-child{border-right:0!important}
      .quick-action:hover{transform:none!important;background:rgba(255,255,255,.025)!important}
      .quick-copy{display:block;width:100%;text-align:center!important}
      .quick-copy strong{display:block;margin:0 0 5px!important;color:#ef1727!important;font-size:13px!important;line-height:1.1!important;font-weight:900!important;letter-spacing:.08em;text-transform:uppercase;white-space:normal!important}
      .quick-copy small{display:block!important;margin:0;color:#c7c8cc!important;font-size:12px!important;line-height:1.35!important;font-weight:650}
      .quick-action:hover .quick-copy small{color:#fff!important}

      /* Showroom */
      .showroom-section{padding:10px 0 0}
      .showroom-card{width:min(1220px,calc(100% - 40px));margin:0 auto;overflow:hidden;display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);border:1px solid rgba(255,255,255,.10);border-radius:26px 26px 0 0;background:#141518;box-shadow:0 28px 80px rgba(0,0,0,.34)}
      .showroom-info{padding:46px 48px 44px}
      .showroom-info h2{margin:10px 0 14px;color:#fff;font-size:clamp(30px,3.3vw,44px);line-height:1.05;letter-spacing:-.035em}
      .showroom-intro{max-width:600px;margin:0 0 28px;color:#a7a9ae;font-size:15px;line-height:1.65}
      .contact-list{display:grid;gap:0}
      .contact-row{display:grid;grid-template-columns:52px 1fr;align-items:center;gap:15px;padding:13px 0;border-top:1px solid rgba(255,255,255,.065)}
      .contact-row:first-child{border-top:0}
      .contact-icon{width:48px;height:48px;display:grid;place-items:center;border-radius:50%;background:rgba(207,23,37,.14);border:1px solid rgba(240,42,55,.15);color:#ff3d49}
      .contact-icon svg{width:25px;height:25px;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round;display:block}
      .contact-row small{display:block;margin-bottom:4px;color:#8e9096;font-size:10px;font-weight:850;letter-spacing:.1em}
      .contact-row strong{display:block;color:#f4f4f5;font-size:15px;line-height:1.42;font-weight:700}
      a.contact-row:hover strong{color:#ff5964}
      .showroom-map{position:relative;min-height:575px;background:#f1f1f1;overflow:hidden}
      .showroom-map iframe{position:absolute;inset:0;width:100%;height:100%;border:0;filter:none !important;opacity:1 !important}
      .showroom-map:after{display:none !important}
      .map-open{position:absolute;z-index:3;right:20px;bottom:20px;padding:12px 16px;border:1px solid rgba(0,0,0,.10);border-radius:11px;background:rgba(255,255,255,.94);color:#121214;font-size:12px;font-weight:850;box-shadow:0 10px 30px rgba(0,0,0,.14);backdrop-filter:blur(10px)}
      .map-open:hover{background:#cf1725;border-color:#cf1725;color:#fff}

      @media(max-width:980px){
        .showroom-card{grid-template-columns:1fr}.showroom-map{min-height:430px}
      }
      @media(max-width:700px){
        .brand-logo{width:145px}
        .quick-actions-wrap{overflow:hidden}
        .quick-actions{width:100%!important;display:flex!important;overflow-x:auto!important;scroll-snap-type:x mandatory!important;scrollbar-width:none!important;padding:0 18px!important;gap:0!important;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch}
        .quick-actions::-webkit-scrollbar{display:none}
        .quick-action{flex:0 0 82%!important;min-height:84px!important;padding:13px 18px!important;border-right:1px solid rgba(255,255,255,.10)!important;scroll-snap-align:center!important;scroll-snap-stop:always!important}
        .quick-action:first-child{border-left:1px solid rgba(255,255,255,.10)!important}
        .quick-action:last-child{margin-right:18px}
        .quick-copy strong{font-size:12px!important}
        .quick-copy small{font-size:11px!important}
        .showroom-card{width:min(100% - 26px,1220px);border-radius:22px 22px 0 0}
        .showroom-info{padding:30px 24px}.showroom-map{min-height:390px}.contact-row{grid-template-columns:50px 1fr}.contact-icon{width:46px;height:46px}.contact-icon svg{width:24px;height:24px}
      }

      /* V8: mobile carousel + WhatsApp header */
      .header-whatsapp{background:#25D366!important;color:#0a0a0b!important;box-shadow:0 10px 28px rgba(37,211,102,.22)!important;font-weight:900!important}
      .header-whatsapp:hover{background:#20bd5a!important;color:#0a0a0b!important}

      @media(max-width:700px){
        .quick-actions-wrap{overflow:hidden!important}
        .quick-actions-bar{overflow:hidden!important}
        .quick-actions-bar .quick-actions.container{
          width:100%!important;
          max-width:none!important;
          margin:0!important;
          padding:0 18px!important;
          display:grid!important;
          grid-template-columns:none!important;
          grid-auto-flow:column!important;
          grid-auto-columns:84vw!important;
          gap:12px!important;
          overflow-x:auto!important;
          overflow-y:hidden!important;
          scroll-snap-type:x mandatory!important;
          scroll-padding-left:18px!important;
          overscroll-behavior-x:contain!important;
          -webkit-overflow-scrolling:touch!important;
          scrollbar-width:none!important;
          touch-action:pan-x!important;
        }
        .quick-actions-bar .quick-actions.container::-webkit-scrollbar{display:none!important}
        .quick-actions-bar .quick-action{
          width:100%!important;
          min-width:0!important;
          flex:none!important;
          min-height:88px!important;
          margin:0!important;
          padding:15px 18px!important;
          border:1px solid rgba(255,255,255,.09)!important;
          border-radius:14px!important;
          background:rgba(16,16,18,.96)!important;
          scroll-snap-align:start!important;
          scroll-snap-stop:always!important;
        }
        .quick-actions-bar .quick-action:last-child{margin-right:18px!important}
        .quick-actions-bar .quick-copy{width:100%!important;text-align:center!important}
        .quick-actions-bar .quick-copy strong{font-size:12px!important;letter-spacing:.12em!important;color:#ff4b57!important;text-transform:uppercase!important}
        .quick-actions-bar .quick-copy small{font-size:11px!important;line-height:1.35!important;color:#b0b1b6!important}
      }

      /* V9: controles del carrusel mobile + footer final */
      .quick-carousel-controls{display:none}
      .site-footer-final{border-top:1px solid rgba(255,255,255,.08);background:#080809}
      .site-footer-inner{width:min(1220px,calc(100% - 40px));margin:0 auto;min-height:112px;display:flex;align-items:center;justify-content:space-between;gap:28px;padding:24px 0}
      .site-footer-brand img{display:block;width:150px;height:auto}
      .site-footer-links{display:flex;align-items:center;gap:20px;flex-wrap:wrap;justify-content:flex-end}
      .site-footer-links a{color:#a7a9ae;font-size:12px;font-weight:700;text-decoration:none}
      .site-footer-links a:hover{color:#fff}
      .site-footer-copy{color:#666970;font-size:11px;margin-top:7px}

      @media(max-width:700px){
        .quick-actions-bar{position:relative!important;padding:0!important}
        .quick-carousel-controls{display:none!important}
        .site-footer-inner{width:min(100% - 28px,1220px);min-height:auto;align-items:flex-start;flex-direction:column;padding:28px 0}
        .site-footer-brand img{width:138px}
        .site-footer-links{justify-content:flex-start;gap:14px 18px}
      }
      .catalog-loading{grid-column:1/-1;padding:48px 20px;text-align:center;color:#9da0a6;font-size:14px}
      .catalog-error{grid-column:1/-1;padding:32px 20px;text-align:center;color:#ff7180;border:1px solid rgba(255,70,90,.22);border-radius:16px;background:rgba(110,15,28,.08)}
    </style>
  </head>

