---
import { autos } from '../data/autos.js';
import '../styles/global.css';

const formatPrice = (value) => value > 0 ? `$${value.toLocaleString('es-AR')}` : 'Consultar';
const formatKm = (value) => `${value.toLocaleString('es-AR')} km`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Catálogo de vehículos de Automotores Lopez" />
    <title>Automotores Lopez | Vehículos</title>
  </head>
  <body>
    <header class="header">
      <div class="container nav">
        <a class="brand" href="#">LOPEZ<span>.</span></a>
        <nav class="navlinks">
          <a href="#vehiculos">Vehículos</a>
          <a href="#">Financiación</a>
          <a href="#">Vendé tu auto</a>
          <a href="#">Contacto</a>
        </nav>
        <a class="cta" href="https://wa.me/543513489872" target="_blank" rel="noreferrer">WhatsApp</a>
      </div>
    </header>

    <main>
      <section class="hero hero-photo">
        <img class="hero-bg" src="/images/fiat-toro-volcano-2017-01.png" alt="Fiat Toro en Automotores Lopez" />
        <div class="hero-overlay"></div>
        <div class="container hero-content">
          <div class="hero-card">
            <div>
              <div class="eyebrow">AUTOMOTORES LOPEZ</div>
              <h1>Encontrá tu próximo auto.</h1>
              <p>Vehículos seleccionados, atención personalizada y un catálogo simple para encontrar lo que buscás.</p>
            </div>
          </div>
        </div>
      </section>

      <section id="vehiculos" class="container">
        <div class="section-head">
          <div>
            <div class="eyebrow">STOCK DISPONIBLE</div>
            <h2>Vehículos</h2>
          </div>
          <p>{autos.length} unidades cargadas</p>
        </div>

        <div class="filters">
          <input id="search" class="input" type="search" placeholder="Buscar marca o modelo..." />
          <select id="brand" class="select">
            <option value="">Todas las marcas</option>
            {[...new Set(autos.map(a => a.marca))].map(marca => <option value={marca}>{marca}</option>)}
          </select>
          <select id="type" class="select">
            <option value="">Todos los tipos</option>
            {[...new Set(autos.map(a => a.tipo))].map(tipo => <option value={tipo}>{tipo}</option>)}
          </select>
          <select id="sort" class="select">
            <option value="">Ordenar</option>
            <option value="year-desc">Más nuevos</option>
            <option value="km-asc">Menor kilometraje</option>
            <option value="price-asc">Menor precio</option>
          </select>
        </div>

        <div id="grid" class="grid">
          {autos.map(auto => (
            <article class="card" data-marca={auto.marca} data-tipo={auto.tipo} data-name={`${auto.marca} ${auto.modelo}`.toLowerCase()} data-year={auto.anio} data-km={auto.km} data-price={auto.precio || 999999999}>
              <img src={auto.imagen} alt={`${auto.marca} ${auto.modelo}`} />
              <div class="card-body">
                {auto.destacado && <div class="badge">DESTACADO</div>}
                <h3>{auto.marca} {auto.modelo}</h3>
                <div class="meta">{auto.anio} · {formatKm(auto.km)} · {auto.tipo}</div>
                <div class="price">{formatPrice(auto.precio)}</div>
                <a class="card-link" href={`/vehiculos/${auto.id}`}>Ver vehículo</a>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container">Automotores Lopez · Villa Allende, Córdoba</div>
    </footer>

    <script>
      const search = document.querySelector('#search');
      const brand = document.querySelector('#brand');
      const type = document.querySelector('#type');
      const sort = document.querySelector('#sort');
      const grid = document.querySelector('#grid');

      function updateCatalog() {
        const cards = [...grid.querySelectorAll('.card')];
        const term = search.value.trim().toLowerCase();
        const brandValue = brand.value;
        const typeValue = type.value;

        cards.forEach(card => {
          const visible = (!term || card.dataset.name.includes(term)) &&
            (!brandValue || card.dataset.marca === brandValue) &&
            (!typeValue || card.dataset.tipo === typeValue);
          card.style.display = visible ? '' : 'none';
        });

        const sorter = sort.value;
        if (sorter) {
          const sorted = cards.sort((a, b) => {
            if (sorter === 'year-desc') return Number(b.dataset.year) - Number(a.dataset.year);
            if (sorter === 'km-asc') return Number(a.dataset.km) - Number(b.dataset.km);
            if (sorter === 'price-asc') return Number(a.dataset.price) - Number(b.dataset.price);
            return 0;
          });
          sorted.forEach(card => grid.appendChild(card));
        }
      }

      [search, brand, type, sort].forEach(el => el.addEventListener('input', updateCatalog));
      [brand, type, sort].forEach(el => el.addEventListener('change', updateCatalog));
    </script>
  </body>
</html>
