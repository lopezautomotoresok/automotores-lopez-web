---
import { autos } from '../data/autos.js';
import '../styles/global.css';

const formatPrice = (value) => value > 0 ? `$${value.toLocaleString('es-AR')}` : 'Consultar precio';
const formatKm = (value) => `${value.toLocaleString('es-AR')} km`;
const marcas = [...new Set(autos.map((a) => a.marca))];
const tipos = [...new Set(autos.map((a) => a.tipo))];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Catálogo de vehículos seleccionados de Automotores Lopez en Villa Allende, Córdoba." />
    <meta name="theme-color" content="#0a0a0b" />
    <title>Automotores Lopez | Vehículos seleccionados</title>

    <style>
      /* Identidad */
      .brand-logo{display:block;width:178px;flex:0 0 auto}
      .brand-logo img{display:block;width:100%;height:auto;object-fit:contain}

      /* Barra de accesos — tres bloques compactos inspirados en la referencia */
      .quick-actions-wrap{position:relative;z-index:2;margin:0;padding:0;background:#0b0b0c;border-top:1px solid rgba(255,255,255,.07);border-bottom:1px solid rgba(255,255,255,.07);overflow:hidden}
      .quick-actions-bar{background:
        radial-gradient(circle at 13% 35%, rgba(207,23,37,.14) 0 2px, transparent 3px),
        radial-gradient(circle at 82% 68%, rgba(255,255,255,.10) 0 2px, transparent 3px),
        radial-gradient(circle at 54% 18%, rgba(255,255,255,.08) 0 1.5px, transparent 2.5px),
        linear-gradient(180deg,#101012 0%,#0b0b0c 100%);
      }
      .quick-actions{width:min(1100px,calc(100% - 40px));margin:0 auto;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));}
      .quick-action{position:relative;min-height:88px;display:flex;align-items:center;justify-content:center;padding:14px 24px;background:transparent!important;border:0!important;border-right:1px solid rgba(255,255,255,.10)!important;border-radius:0!important;box-shadow:none!important;text-align:center;transition:background .18s ease}
      .quick-action:last-child{border-right:0!important}
      .quick-action:hover{transform:none!important;background:rgba(255,255,255,.025)!important}
      .quick-copy{display:block;width:100%;text-align:center!important}
      .quick-copy strong{display:block;margin:0 0 5px!important;color:#ef1727!important;font-size:13px!important;line-height:1.1!important;font-weight:900!important;letter-spacing:.08em;text-transform:uppercase;white-space:normal!important}
      .quick-copy small{display:block!important;margin:0;color:#c7c8cc!important;font-size:12px!important;line-height:1.35!important;font-weight:650}
      .quick-action:hover .quick-copy small{color:#fff!important}

      /* Showroom */
      .showroom-section{padding:10px 0 0}
      .showroom-card{width:min(1220px,calc(100% - 40px));margin:0 auto;overflow:hidden;display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);border:1px solid rgba(255,255,255,.10);border-radius:26px 26px 0 0;background:#141518;box-shadow:0 28px 80px rgba(0,0,0,.34)}
      .showroom-info{padding:46px 48px 44px}
      .showroom-info h2{margin:10px 0 14px;color:#fff;font-size:clamp(30px,3.3vw,44px);line-height:1.05;letter-spacing:-.035em}
      .showroom-intro{max-width:600px;margin:0 0 28px;color:#a7a9ae;font-size:15px;line-height:1.65}
      .contact-list{display:grid;gap:0}
      .contact-row{display:grid;grid-template-columns:52px 1fr;align-items:center;gap:15px;padding:13px 0;border-top:1px solid rgba(255,255,255,.065)}
      .contact-row:first-child{border-top:0}
      .contact-icon{width:48px;height:48px;display:grid;place-items:center;border-radius:50%;background:rgba(207,23,37,.14);border:1px solid rgba(240,42,55,.15);color:#ff3d49}
      .contact-icon svg{width:25px;height:25px;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round;display:block}
      .contact-row small{display:block;margin-bottom:4px;color:#8e9096;font-size:10px;font-weight:850;letter-spacing:.1em}
      .contact-row strong{display:block;color:#f4f4f5;font-size:15px;line-height:1.42;font-weight:700}
      a.contact-row:hover strong{color:#ff5964}
      .showroom-map{position:relative;min-height:575px;background:#f1f1f1;overflow:hidden}
      .showroom-map iframe{position:absolute;inset:0;width:100%;height:100%;border:0;filter:none !important;opacity:1 !important}
      .showroom-map:after{display:none !important}
      .map-open{position:absolute;z-index:3;right:20px;bottom:20px;padding:12px 16px;border:1px solid rgba(0,0,0,.10);border-radius:11px;background:rgba(255,255,255,.94);color:#121214;font-size:12px;font-weight:850;box-shadow:0 10px 30px rgba(0,0,0,.14);backdrop-filter:blur(10px)}
      .map-open:hover{background:#cf1725;border-color:#cf1725;color:#fff}

      @media(max-width:980px){
        .showroom-card{grid-template-columns:1fr}.showroom-map{min-height:430px}
      }
      @media(max-width:700px){
        .brand-logo{width:145px}
        .quick-actions-wrap{overflow:hidden}
        .quick-actions{width:100%!important;display:flex!important;overflow-x:auto!important;scroll-snap-type:x mandatory!important;scrollbar-width:none!important;padding:0 18px!important;gap:0!important;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch}
        .quick-actions::-webkit-scrollbar{display:none}
        .quick-action{flex:0 0 82%!important;min-height:84px!important;padding:13px 18px!important;border-right:1px solid rgba(255,255,255,.10)!important;scroll-snap-align:center!important;scroll-snap-stop:always!important}
        .quick-action:first-child{border-left:1px solid rgba(255,255,255,.10)!important}
        .quick-action:last-child{margin-right:18px}
        .quick-copy strong{font-size:12px!important}
        .quick-copy small{font-size:11px!important}
        .showroom-card{width:min(100% - 26px,1220px);border-radius:22px 22px 0 0}
        .showroom-info{padding:30px 24px}.showroom-map{min-height:390px}.contact-row{grid-template-columns:50px 1fr}.contact-icon{width:46px;height:46px}.contact-icon svg{width:24px;height:24px}
      }
    </style>
  </head>

  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="brand-logo" href="#top" aria-label="Automotores Lopez">
          <img src="/images/logo-lopez.png" alt="Lopez Automotores" />
        </a>

        <nav class="navlinks" aria-label="Navegación principal">
          <a href="#vehiculos">Vehículos</a>
          <a href="https://wa.me/543513489872?text=Hola%2C%20quiero%20consultar%20por%20opciones%20de%20financiaci%C3%B3n." target="_blank" rel="noreferrer">Financiación</a>
          <a href="https://wa.me/543513489872?text=Hola%2C%20quiero%20consultar%20por%20entregar%20mi%20veh%C3%ADculo%20como%20parte%20de%20pago." target="_blank" rel="noreferrer">Vendé tu auto</a>
          <a href="#contacto">Contacto</a>
        </nav>

        <a class="button button-small button-red" href="https://wa.me/543513489872" target="_blank" rel="noreferrer">
          WhatsApp
        </a>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <img class="hero-bg" src="/images/fiat-toro-volcano-2017-01.png" alt="Vehículo disponible en Automotores Lopez" />
        <div class="hero-overlay"></div>
        <div class="hero-glow"></div>

        <div class="container hero-inner">
          <div class="hero-copy">
            <div class="eyebrow">AUTOMOTORES LOPEZ · VILLA ALLENDE</div>
            <h1>Tu próximo auto,<br /><span>más cerca.</span></h1>
            <p>Vehículos seleccionados, atención personalizada y opciones para que encuentres la unidad que mejor encaja con vos.</p>

            <div class="hero-actions">
              <a class="button button-red" href="#vehiculos">Ver vehículos</a>
              <a class="button button-ghost" href="https://wa.me/543513489872?text=Hola%2C%20quiero%20consultar%20por%20los%20veh%C3%ADculos%20disponibles." target="_blank" rel="noreferrer">Consultar por WhatsApp</a>
            </div>
          </div>

          <div class="hero-status">
            <span class="status-dot"></span>
            <div>
              <strong>Stock actualizado</strong>
              <small>{autos.length} {autos.length === 1 ? 'vehículo disponible' : 'vehículos disponibles'}</small>
            </div>
          </div>
        </div>
      </section>

      <section class="quick-actions-wrap" aria-label="Accesos rápidos">
        <div class="quick-actions-bar">
          <div class="container quick-actions">
            <a class="quick-action" href="#vehiculos">
              <span class="quick-copy">
                <strong>Usados seleccionados</strong>
                <small>Explorá todas las unidades disponibles</small>
              </span>
            </a>

            <a class="quick-action" href="https://wa.me/543513489872?text=Hola%2C%20quiero%20consultar%20por%20opciones%20de%20financiaci%C3%B3n." target="_blank" rel="noreferrer">
              <span class="quick-copy">
                <strong>Financiación</strong>
                <small>Consultá alternativas para la unidad que te interesa</small>
              </span>
            </a>

            <a class="quick-action" href="https://wa.me/543513489872?text=Hola%2C%20quiero%20consultar%20por%20entregar%20mi%20veh%C3%ADculo%20como%20parte%20de%20pago." target="_blank" rel="noreferrer">
              <span class="quick-copy">
                <strong>Tomamos tu usado</strong>
                <small>Podés entregarlo como parte de pago</small>
              </span>
            </a>
          </div>
        </div>
      </section>

      <section id="vehiculos" class="catalog-section">
        <div class="container">
          <div class="section-head section-head-centered">
            <div>
              <div class="eyebrow">STOCK DISPONIBLE</div>
              <h2>Elegí el que va con vos.</h2>
            </div>
            <p><strong id="visibleCount">{autos.length}</strong> {autos.length === 1 ? 'unidad' : 'unidades'}</p>
          </div>

          <div class="filter-panel">
            <div class="filter-title">
              <div>
                <strong>Buscá tu vehículo</strong>
                <span>Filtrá el stock disponible.</span>
              </div>
              <button id="clearFilters" class="clear-button" type="button">Limpiar filtros</button>
            </div>

            <div class="filters">
              <label class="field field-search">
                <span>Buscar</span>
                <input id="search" class="input" type="search" placeholder="Marca, modelo o versión..." />
              </label>

              <label class="field">
                <span>Marca</span>
                <select id="brand" class="select">
                  <option value="">Todas</option>
                  {marcas.map((marca) => <option value={marca}>{marca}</option>)}
                </select>
              </label>

              <label class="field">
                <span>Tipo</span>
                <select id="type" class="select">
                  <option value="">Todos</option>
                  {tipos.map((tipo) => <option value={tipo}>{tipo}</option>)}
                </select>
              </label>

              <label class="field">
                <span>Ordenar</span>
                <select id="sort" class="select">
                  <option value="">Relevancia</option>
                  <option value="year-desc">Más nuevos</option>
                  <option value="km-asc">Menor kilometraje</option>
                  <option value="price-asc">Menor precio</option>
                </select>
              </label>
            </div>
          </div>

          <div id="grid" class="vehicle-grid">
            {autos.map((auto) => (
              <article
                class="vehicle-card"
                data-marca={auto.marca}
                data-tipo={auto.tipo}
                data-name={`${auto.marca} ${auto.modelo}`.toLowerCase()}
                data-year={auto.anio}
                data-km={auto.km}
                data-price={auto.precio || 999999999}
              >
                <a class="vehicle-image-wrap" href={`/vehiculos/${auto.id}`} aria-label={`Ver ${auto.marca} ${auto.modelo}`}>
                  <img class="vehicle-image" src={auto.imagen} alt={`${auto.marca} ${auto.modelo}`} loading="lazy" />
                  <div class="vehicle-image-overlay"></div>
                  <div class="view-hint">Ver vehículo <span>→</span></div>
                </a>

                <div class="vehicle-body">
                  <div class="vehicle-heading">
                    <div>
                      <div class="vehicle-brand">{auto.marca}</div>
                      <h3>{auto.modelo}</h3>
                    </div>
                    <div class="vehicle-year">{auto.anio}</div>
                  </div>

                  <div class="vehicle-meta">
                    <span>{formatKm(auto.km)}</span>
                    <span>{auto.combustible}</span>
                    <span>{auto.transmision}</span>
                  </div>

                  <div class="vehicle-footer">
                    <div>
                      <small>Precio</small>
                      <div class="price">{formatPrice(auto.precio)}</div>
                    </div>
                    <a class="arrow-button" href={`/vehiculos/${auto.id}`} aria-label="Ver ficha del vehículo">→</a>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <div id="emptyState" class="empty-state" hidden>
            <strong>No encontramos vehículos con esos filtros.</strong>
            <span>Probá cambiando la búsqueda o limpiando los filtros.</span>
          </div>
        </div>
      </section>

      <section id="contacto" class="showroom-section">
        <div class="container showroom-card">
          <div class="showroom-info">
            <div class="eyebrow">VENÍ A CONOCERNOS</div>
            <h2>Lopez Automotores Showroom</h2>
            <p class="showroom-intro">Nuestras puertas están abiertas para asesorarte, mostrarte el stock y ayudarte a encontrar tu próximo vehículo.</p>

            <div class="contact-list">
              <a class="contact-row" href="https://www.google.com/maps/search/?api=1&query=R%C3%ADo%20de%20Janeiro%201381%2C%20Villa%20Allende%2C%20C%C3%B3rdoba" target="_blank" rel="noreferrer">
                <span class="contact-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 21s6-5.2 6-12A6 6 0 0 0 6 9c0 6.8 6 12 6 12Z"/><circle cx="12" cy="9" r="2.2"/></svg></span>
                <span><small>DIRECCIÓN</small><strong>Río de Janeiro 1381, Villa Allende · Córdoba</strong></span>
              </a>

              <div class="contact-row">
                <span class="contact-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8"/><path d="M12 7v5l3 2"/></svg></span>
                <span><small>HORARIO</small><strong>19:00 a 20:00 hs</strong></span>
              </div>

              <a class="contact-row" href="https://wa.me/543513489872" target="_blank" rel="noreferrer">
                <span class="contact-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M7.5 4.5 5 6.2c-.7.5-.9 1.4-.6 2.2 1.7 4.6 5.3 8.2 9.9 9.9.8.3 1.7.1 2.2-.6l1.7-2.5-3.6-2-1.5 1.5c-2.2-1-3.9-2.7-4.9-4.9l1.5-1.5-2.2-3.8Z"/></svg></span>
                <span><small>WHATSAPP</small><strong>351 348-9872</strong></span>
              </a>

              <a class="contact-row" href="mailto:lopezautomotoresok@gmail.com">
                <span class="contact-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><rect x="4" y="6" width="16" height="12" rx="2"/><path d="m5 8 7 5 7-5"/></svg></span>
                <span><small>EMAIL</small><strong>lopezautomotoresok@gmail.com</strong></span>
              </a>

              <a class="contact-row" href="https://www.instagram.com/lopez.automotores5/" target="_blank" rel="noreferrer">
                <span class="contact-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><rect x="5" y="5" width="14" height="14" rx="4"/><circle cx="12" cy="12" r="3.2"/><circle cx="16.8" cy="7.4" r=".8" fill="currentColor" stroke="none"/></svg></span>
                <span><small>INSTAGRAM</small><strong>@lopez.automotores5</strong></span>
              </a>
            </div>
          </div>

          <div class="showroom-map">
            <iframe
              title="Ubicación de Lopez Automotores"
              src="https://www.google.com/maps?q=R%C3%ADo%20de%20Janeiro%201381%2C%20Villa%20Allende%2C%20C%C3%B3rdoba%2C%20Argentina&output=embed"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade">
            </iframe>
            <a class="map-open" href="https://www.google.com/maps/search/?api=1&query=R%C3%ADo%20de%20Janeiro%201381%2C%20Villa%20Allende%2C%20C%C3%B3rdoba" target="_blank" rel="noreferrer">Abrir en Google Maps ↗</a>
          </div>
        </div>
      </section>
    </main>



    <script>
      const search = document.querySelector('#search');
      const brand = document.querySelector('#brand');
      const type = document.querySelector('#type');
      const sort = document.querySelector('#sort');
      const clearFilters = document.querySelector('#clearFilters');
      const grid = document.querySelector('#grid');
      const visibleCount = document.querySelector('#visibleCount');
      const emptyState = document.querySelector('#emptyState');

      function updateCatalog() {
        const cards = [...grid.querySelectorAll('.vehicle-card')];
        const term = search.value.trim().toLowerCase();
        const brandValue = brand.value;
        const typeValue = type.value;
        let count = 0;

        cards.forEach((card) => {
          const visible = (!term || card.dataset.name.includes(term)) &&
            (!brandValue || card.dataset.marca === brandValue) &&
            (!typeValue || card.dataset.tipo === typeValue);
          card.hidden = !visible;
          if (visible) count++;
        });

        const sorter = sort.value;
        if (sorter) {
          const sorted = cards.sort((a, b) => {
            if (sorter === 'year-desc') return Number(b.dataset.year) - Number(a.dataset.year);
            if (sorter === 'km-asc') return Number(a.dataset.km) - Number(b.dataset.km);
            if (sorter === 'price-asc') return Number(a.dataset.price) - Number(b.dataset.price);
            return 0;
          });
          sorted.forEach((card) => grid.appendChild(card));
        }

        visibleCount.textContent = String(count);
        emptyState.hidden = count !== 0;
      }

      [search, brand, type, sort].forEach((el) => el.addEventListener('input', updateCatalog));
      [brand, type, sort].forEach((el) => el.addEventListener('change', updateCatalog));

      clearFilters.addEventListener('click', () => {
        search.value = '';
        brand.value = '';
        type.value = '';
        sort.value = '';
        updateCatalog();
        search.focus();
      });
    </script>
  </body>
</html>
