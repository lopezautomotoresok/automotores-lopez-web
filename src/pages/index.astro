---
import { autos } from '../data/autos.js';
import '../styles/global.css';

const formatPrice = (value) => value > 0 ? `$${value.toLocaleString('es-AR')}` : 'Consultar precio';
const formatKm = (value) => `${value.toLocaleString('es-AR')} km`;
const marcas = [...new Set(autos.map((a) => a.marca))];
const tipos = [...new Set(autos.map((a) => a.tipo))];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Catálogo de vehículos seleccionados de Automotores Lopez en Villa Allende, Córdoba." />
    <meta name="theme-color" content="#0a0a0b" />
    <title>Automotores Lopez | Vehículos seleccionados</title>
  </head>

  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href="#top" aria-label="Automotores Lopez">
          <span class="brand-main">LOPEZ</span>
          <span class="brand-sub"><i></i>AUTOMOTORES</span>
        </a>

        <nav class="navlinks" aria-label="Navegación principal">
          <a href="#vehiculos">Vehículos</a>
          <a href="https://wa.me/543513489872?text=Hola%2C%20quiero%20consultar%20por%20opciones%20de%20financiaci%C3%B3n." target="_blank" rel="noreferrer">Financiación</a>
          <a href="https://wa.me/543513489872?text=Hola%2C%20quiero%20consultar%20por%20entregar%20mi%20veh%C3%ADculo%20como%20parte%20de%20pago." target="_blank" rel="noreferrer">Vendé tu auto</a>
          <a href="#contacto">Contacto</a>
        </nav>

        <a class="button button-small button-red" href="https://wa.me/543513489872" target="_blank" rel="noreferrer">
          WhatsApp
        </a>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <img class="hero-bg" src="/images/fiat-toro-volcano-2017-01.png" alt="Vehículo disponible en Automotores Lopez" />
        <div class="hero-overlay"></div>
        <div class="hero-glow"></div>

        <div class="container hero-inner">
          <div class="hero-copy">
            <div class="eyebrow">AUTOMOTORES LOPEZ · VILLA ALLENDE</div>
            <h1>Tu próximo auto,<br /><span>más cerca.</span></h1>
            <p>Vehículos seleccionados, atención personalizada y opciones para que encuentres la unidad que mejor encaja con vos.</p>

            <div class="hero-actions">
              <a class="button button-red" href="#vehiculos">Ver vehículos</a>
              <a class="button button-ghost" href="https://wa.me/543513489872?text=Hola%2C%20quiero%20consultar%20por%20los%20veh%C3%ADculos%20disponibles." target="_blank" rel="noreferrer">Consultar por WhatsApp</a>
            </div>
          </div>

          <div class="hero-status">
            <span class="status-dot"></span>
            <div>
              <strong>Stock actualizado</strong>
              <small>{autos.length} {autos.length === 1 ? 'vehículo disponible' : 'vehículos disponibles'}</small>
            </div>
          </div>
        </div>
      </section>

      <section class="quick-actions-wrap" aria-label="Accesos rápidos">
        <div class="container quick-actions">
          <a class="quick-action" href="#vehiculos">
            <span class="quick-icon">01</span>
            <span class="quick-copy">
              <strong>Usados seleccionados</strong>
              <small>Explorá todas las unidades disponibles</small>
            </span>
            <span class="quick-arrow">→</span>
          </a>

          <a class="quick-action" href="https://wa.me/543513489872?text=Hola%2C%20quiero%20consultar%20por%20opciones%20de%20financiaci%C3%B3n." target="_blank" rel="noreferrer">
            <span class="quick-icon">02</span>
            <span class="quick-copy">
              <strong>Financiación</strong>
              <small>Consultá alternativas para la unidad que te interesa</small>
            </span>
            <span class="quick-arrow">→</span>
          </a>

          <a class="quick-action" href="https://wa.me/543513489872?text=Hola%2C%20quiero%20consultar%20por%20entregar%20mi%20veh%C3%ADculo%20como%20parte%20de%20pago." target="_blank" rel="noreferrer">
            <span class="quick-icon">03</span>
            <span class="quick-copy">
              <strong>Tomamos tu usado</strong>
              <small>Podés entregarlo como parte de pago</small>
            </span>
            <span class="quick-arrow">→</span>
          </a>
        </div>
      </section>

      <section id="vehiculos" class="catalog-section">
        <div class="container">
          <div class="section-head">
            <div>
              <div class="eyebrow">STOCK DISPONIBLE</div>
              <h2>Elegí el que va con vos.</h2>
            </div>
            <p><strong id="visibleCount">{autos.length}</strong> {autos.length === 1 ? 'unidad' : 'unidades'}</p>
          </div>

          <div class="filter-panel">
            <div class="filter-title">
              <div>
                <strong>Buscá tu vehículo</strong>
                <span>Filtrá el stock disponible.</span>
              </div>
              <button id="clearFilters" class="clear-button" type="button">Limpiar filtros</button>
            </div>

            <div class="filters">
              <label class="field field-search">
                <span>Buscar</span>
                <input id="search" class="input" type="search" placeholder="Marca, modelo o versión..." />
              </label>

              <label class="field">
                <span>Marca</span>
                <select id="brand" class="select">
                  <option value="">Todas</option>
                  {marcas.map((marca) => <option value={marca}>{marca}</option>)}
                </select>
              </label>

              <label class="field">
                <span>Tipo</span>
                <select id="type" class="select">
                  <option value="">Todos</option>
                  {tipos.map((tipo) => <option value={tipo}>{tipo}</option>)}
                </select>
              </label>

              <label class="field">
                <span>Ordenar</span>
                <select id="sort" class="select">
                  <option value="">Relevancia</option>
                  <option value="year-desc">Más nuevos</option>
                  <option value="km-asc">Menor kilometraje</option>
                  <option value="price-asc">Menor precio</option>
                </select>
              </label>
            </div>
          </div>

          <div id="grid" class="vehicle-grid">
            {autos.map((auto) => (
              <article
                class="vehicle-card"
                data-marca={auto.marca}
                data-tipo={auto.tipo}
                data-name={`${auto.marca} ${auto.modelo}`.toLowerCase()}
                data-year={auto.anio}
                data-km={auto.km}
                data-price={auto.precio || 999999999}
              >
                <a class="vehicle-image-wrap" href={`/vehiculos/${auto.id}`} aria-label={`Ver ${auto.marca} ${auto.modelo}`}>
                  <img class="vehicle-image" src={auto.imagen} alt={`${auto.marca} ${auto.modelo}`} loading="lazy" />
                  <div class="vehicle-image-overlay"></div>
                  {auto.destacado && <div class="badge">DESTACADO</div>}
                  <div class="view-hint">Ver vehículo <span>→</span></div>
                </a>

                <div class="vehicle-body">
                  <div class="vehicle-heading">
                    <div>
                      <div class="vehicle-brand">{auto.marca}</div>
                      <h3>{auto.modelo}</h3>
                    </div>
                    <div class="vehicle-year">{auto.anio}</div>
                  </div>

                  <div class="vehicle-meta">
                    <span>{formatKm(auto.km)}</span>
                    <span>{auto.combustible}</span>
                    <span>{auto.transmision}</span>
                  </div>

                  <div class="vehicle-footer">
                    <div>
                      <small>Precio</small>
                      <div class="price">{formatPrice(auto.precio)}</div>
                    </div>
                    <a class="arrow-button" href={`/vehiculos/${auto.id}`} aria-label="Ver ficha del vehículo">→</a>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <div id="emptyState" class="empty-state" hidden>
            <strong>No encontramos vehículos con esos filtros.</strong>
            <span>Probá cambiando la búsqueda o limpiando los filtros.</span>
          </div>
        </div>
      </section>

      <section id="contacto" class="showroom-section">
        <div class="container showroom-card">
          <div class="showroom-info">
            <div class="eyebrow">VENÍ A CONOCERNOS</div>
            <h2>Lopez Automotores Showroom</h2>
            <p class="showroom-intro">Nuestras puertas están abiertas para asesorarte, mostrarte el stock y ayudarte a encontrar tu próximo vehículo.</p>

            <div class="contact-list">
              <a class="contact-row" href="https://www.google.com/maps/search/?api=1&query=R%C3%ADo%20de%20Janeiro%201381%2C%20Villa%20Allende%2C%20C%C3%B3rdoba" target="_blank" rel="noreferrer">
                <span class="contact-icon" aria-hidden="true">⌖</span>
                <span><small>DIRECCIÓN</small><strong>Río de Janeiro 1381, Villa Allende · Córdoba</strong></span>
              </a>

              <div class="contact-row">
                <span class="contact-icon" aria-hidden="true">◷</span>
                <span><small>HORARIO</small><strong>Lunes a Viernes · 9:00 a 19:00<br />Sábados · 9:00 a 13:00</strong></span>
              </div>

              <a class="contact-row" href="https://wa.me/543513489872" target="_blank" rel="noreferrer">
                <span class="contact-icon" aria-hidden="true">✆</span>
                <span><small>WHATSAPP</small><strong>351 348-9872</strong></span>
              </a>

              <a class="contact-row" href="mailto:automotorlopez@gmail.com">
                <span class="contact-icon" aria-hidden="true">✉</span>
                <span><small>EMAIL</small><strong>automotorlopez@gmail.com</strong></span>
              </a>

              <a class="contact-row" href="https://www.instagram.com/lopez.automotores5/" target="_blank" rel="noreferrer">
                <span class="contact-icon" aria-hidden="true">◎</span>
                <span><small>INSTAGRAM</small><strong>@lopez.automotores5</strong></span>
              </a>
            </div>
          </div>

          <div class="showroom-map">
            <iframe
              title="Ubicación de Lopez Automotores"
              src="https://www.google.com/maps?q=R%C3%ADo%20de%20Janeiro%201381%2C%20Villa%20Allende%2C%20C%C3%B3rdoba%2C%20Argentina&output=embed"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade">
            </iframe>
            <a class="map-open" href="https://www.google.com/maps/search/?api=1&query=R%C3%ADo%20de%20Janeiro%201381%2C%20Villa%20Allende%2C%20C%C3%B3rdoba" target="_blank" rel="noreferrer">Abrir en Google Maps ↗</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <div class="brand footer-brand">
          <span class="brand-main">LOPEZ</span>
          <span class="brand-sub"><i></i>AUTOMOTORES</span>
        </div>
        <p>Villa Allende · Córdoba</p>
        <p>© {new Date().getFullYear()} Automotores Lopez</p>
      </div>
    </footer>

    <script>
      const search = document.querySelector('#search');
      const brand = document.querySelector('#brand');
      const type = document.querySelector('#type');
      const sort = document.querySelector('#sort');
      const clearFilters = document.querySelector('#clearFilters');
      const grid = document.querySelector('#grid');
      const visibleCount = document.querySelector('#visibleCount');
      const emptyState = document.querySelector('#emptyState');

      function updateCatalog() {
        const cards = [...grid.querySelectorAll('.vehicle-card')];
        const term = search.value.trim().toLowerCase();
        const brandValue = brand.value;
        const typeValue = type.value;
        let count = 0;

        cards.forEach((card) => {
          const visible = (!term || card.dataset.name.includes(term)) &&
            (!brandValue || card.dataset.marca === brandValue) &&
            (!typeValue || card.dataset.tipo === typeValue);
          card.hidden = !visible;
          if (visible) count++;
        });

        const sorter = sort.value;
        if (sorter) {
          const sorted = cards.sort((a, b) => {
            if (sorter === 'year-desc') return Number(b.dataset.year) - Number(a.dataset.year);
            if (sorter === 'km-asc') return Number(a.dataset.km) - Number(b.dataset.km);
            if (sorter === 'price-asc') return Number(a.dataset.price) - Number(b.dataset.price);
            return 0;
          });
          sorted.forEach((card) => grid.appendChild(card));
        }

        visibleCount.textContent = String(count);
        emptyState.hidden = count !== 0;
      }

      [search, brand, type, sort].forEach((el) => el.addEventListener('input', updateCatalog));
      [brand, type, sort].forEach((el) => el.addEventListener('change', updateCatalog));

      clearFilters.addEventListener('click', () => {
        search.value = '';
        brand.value = '';
        type.value = '';
        sort.value = '';
        updateCatalog();
        search.focus();
      });
    </script>
  </body>
</html>
