        </div>
      </div>
      <div class="container footer-bottom">
        <span>© 2026 Lopez Automotores</span>
        <span>Villa Allende · Córdoba</span>
      </div>
    </footer>

    <script>
      import { supabase } from '../lib/supabase.js';

      const search = document.querySelector('#search');
      const brand = document.querySelector('#brand');
      const year = document.querySelector('#year');
      const type = document.querySelector('#type');
      const clearFilters = document.querySelector('#clearFilters');
      const grid = document.querySelector('#grid');
      const visibleCount = document.querySelector('#visibleCount');
      const unitLabel = document.querySelector('#unitLabel');
      const emptyState = document.querySelector('#emptyState');
      let vehicles = [];

      const esc = (value='') => String(value).replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
      const price = (value) => Number(value) > 0 ? new Intl.NumberFormat('es-AR',{style:'currency',currency:'ARS',maximumFractionDigits:0}).format(Number(value)) : 'Consultar precio';
      const km = (value) => value === null || value === undefined ? '—' : `${new Intl.NumberFormat('es-AR').format(Number(value))} km`;
      const shortTransmission = (value='') => { const v=String(value).toLowerCase(); if(v.includes('autom')) return 'Automática'; if(v.includes('manual')) return 'Manual'; return value || '—'; };
      const title = (v) => [v.modelo, v.version].filter(Boolean).join(' ');

      function fillSelect(select, values, firstLabel) {
        select.innerHTML = `<option value="">${firstLabel}</option>` + values.map(v => `<option value="${esc(v)}">${esc(v)}</option>`).join('');
      }

      function renderCards() {
        if (!vehicles.length) { grid.innerHTML=''; updateCatalog(); return; }
        grid.innerHTML = vehicles.map(v => {
          const image = Array.isArray(v.fotos) && v.fotos[0] ? v.fotos[0] : '/images/placeholder-car.svg';
          const name = `${v.marca || ''} ${title(v)}`.trim();
          const href = `/vehiculos/${encodeURIComponent(v.slug)}`;
          return `<article class="vehicle-card" data-marca="${esc(v.marca||'')}" data-tipo="${esc(v.tipo||'')}" data-name="${esc(name.toLowerCase())}" data-year="${esc(v.anio||'')}">
            <a class="vehicle-image-wrap" href="${href}" aria-label="Ver ${esc(name)}">
              <img class="vehicle-image" src="${esc(image)}" alt="${esc(name)}" loading="lazy" />
              <div class="vehicle-image-overlay"></div>
              ${v.anio ? `<span class="vehicle-year-chip">${esc(v.anio)}</span>` : ''}
            </a>
            <div class="vehicle-body">
              <div class="vehicle-title-block"><div class="vehicle-brand">${esc(v.marca||'')}</div><h3>${esc(title(v))}</h3></div>
              <div class="vehicle-specs-clean" aria-label="Datos principales">
                <span>${esc(km(v.kilometraje))}</span><span>${esc(v.tipo||'—')}</span><span>${esc(v.combustible||'—')}</span><span>${esc(shortTransmission(v.transmision))}</span>
              </div>
              <div class="vehicle-footer vehicle-footer-premium">
                <div class="vehicle-price-block"><small>Precio</small><div class="price">${esc(price(v.precio))}</div></div>
                <a class="vehicle-cta" href="${href}"><span>Ver vehículo</span><span aria-hidden="true">→</span></a>
              </div>
            </div>
          </article>`;
        }).join('');
        updateCatalog();
      }

      function updateCatalog() {
        const cards = [...grid.querySelectorAll('.vehicle-card')];
        const term = search.value.trim().toLowerCase();
        const brandValue = brand.value; const yearValue = year.value; const typeValue = type.value;
        let count = 0;
        cards.forEach(card => {
          const visible = (!term || card.dataset.name.includes(term)) && (!brandValue || card.dataset.marca === brandValue) && (!yearValue || card.dataset.year === yearValue) && (!typeValue || card.dataset.tipo === typeValue);
          card.hidden = !visible; if (visible) count++;
        });
        visibleCount.textContent = String(count);
        unitLabel.textContent = count === 1 ? 'unidad' : 'unidades';
        emptyState.hidden = count !== 0 || vehicles.length === 0;
      }

      async function loadCatalog() {
        const { data, error } = await supabase.from('vehiculos').select('*').eq('publicado', true).eq('vendido', false).order('destacado',{ascending:false}).order('created_at',{ascending:false});
        if (error) { grid.innerHTML=`<div class="catalog-error">No pudimos cargar el stock. Probá nuevamente en unos instantes.</div>`; visibleCount.textContent='0'; unitLabel.textContent='unidades'; return; }
        vehicles = data || [];
        const brands=[...new Set(vehicles.map(v=>v.marca).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'es'));
        const years=[...new Set(vehicles.map(v=>v.anio).filter(Boolean))].sort((a,b)=>b-a);
        const types=[...new Set(vehicles.map(v=>v.tipo).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'es'));
        fillSelect(brand,brands,'Todas las marcas'); fillSelect(year,years,'Todos los años'); fillSelect(type,types,'Todos los tipos');
        renderCards();
      }

      [search, brand, year, type].forEach(el => el.addEventListener('input', updateCatalog));
      [brand, year, type].forEach(el => el.addEventListener('change', updateCatalog));
      clearFilters.addEventListener('click', () => { search.value=''; brand.value=''; year.value=''; type.value=''; updateCatalog(); search.focus(); });

      const quickTrack = document.querySelector('.quick-actions');
      const quickCards = quickTrack ? [...quickTrack.querySelectorAll('.quick-action')] : [];
      let quickIndex = 0; let quickTimer;
      const isQuickMobile = () => window.matchMedia('(max-width: 700px)').matches;
      function goToQuick(index) { if (!quickTrack || !quickCards.length || !isQuickMobile()) return; quickIndex=(index+quickCards.length)%quickCards.length; quickTrack.scrollTo({left:quickCards[quickIndex].offsetLeft-18,behavior:'smooth'}); }
      function startQuickAutoplay() { clearInterval(quickTimer); if (!isQuickMobile()) return; quickTimer=setInterval(()=>goToQuick(quickIndex+1),4500); }
      quickTrack?.addEventListener('touchstart',()=>clearInterval(quickTimer),{passive:true});
      quickTrack?.addEventListener('touchend',startQuickAutoplay,{passive:true});
      quickTrack?.addEventListener('scroll',()=>{ if(!isQuickMobile()||!quickCards.length)return; const x=quickTrack.scrollLeft+quickTrack.clientWidth/2; let nearest=0,distance=Infinity; quickCards.forEach((card,i)=>{const center=card.offsetLeft+card.offsetWidth/2,d=Math.abs(center-x); if(d<distance){distance=d;nearest=i;}}); quickIndex=nearest; },{passive:true});
      window.addEventListener('resize',startQuickAutoplay); startQuickAutoplay();
      loadCatalog();
    </script>
  </body>
</html>
