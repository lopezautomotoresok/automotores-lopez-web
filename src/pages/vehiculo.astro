---
import '../styles/global.css';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Vehículo disponible en Lopez Automotores, Villa Allende." />
    <meta name="theme-color" content="#0a0a0b" />
    <title>Vehículo | Lopez Automotores</title>
    <style>
      .detail-loading{padding:70px 20px;text-align:center;color:#9da0a6}
      .detail-error{margin:28px 0;padding:42px 24px;text-align:center;border:1px solid rgba(255,255,255,.1);border-radius:18px;background:#111315}
      .detail-error strong{display:block;font-size:22px;margin-bottom:14px}.detail-error a{color:#ff4050;font-weight:800}
    </style>
  </head>
  <body>
    <header class="site-header vehicle-header">
      <div class="container nav">
        <a class="brand-logo" href="/" aria-label="Lopez Automotores">
          <img src="/images/logo-lopez.png" alt="Lopez Automotores" />
        </a>

        <nav class="navlinks" aria-label="Navegación principal">
          <a href="/#vehiculos">Vehículos</a>
          <a href="https://wa.me/543513489872?text=Hola%2C%20quiero%20consultar%20por%20opciones%20de%20financiaci%C3%B3n." target="_blank" rel="noreferrer">Financiación</a>
          <a href="https://wa.me/543513489872?text=Hola%2C%20quiero%20consultar%20por%20entregar%20mi%20veh%C3%ADculo%20como%20parte%20de%20pago." target="_blank" rel="noreferrer">Vendé tu auto</a>
          <a href="/#contacto">Contacto</a>
        </nav>

        <a class="button button-small header-whatsapp" id="headerWhatsapp" href="https://wa.me/543513489872" target="_blank" rel="noreferrer" aria-label="WhatsApp">
          <svg class="whatsapp-mark" viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3.2A12.5 12.5 0 0 0 5.3 22.1L3.7 28.8l6.9-1.8A12.6 12.6 0 1 0 16 3.2Zm0 22.7c-2 0-3.9-.6-5.5-1.6l-.4-.2-4.1 1.1 1.1-4-.3-.4A10.1 10.1 0 1 1 16 25.9Zm5.5-7.6c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.7.1-1.8-.9-3-1.7-4.2-3.8-.3-.5.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.7-.6-.6-.8-.6h-.7c-.2 0-.6.1-.9.4-.3.4-1.2 1.2-1.2 2.9s1.2 3.3 1.4 3.5c.2.2 2.4 3.7 5.9 5.2 2.2.9 3 .9 4.1.8.7-.1 1.8-.7 2.1-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4Z"/></svg>
        </a>
      </div>
    </header>

    <main class="vehicle-detail-page">
      <div class="container detail-shell">
        <a class="detail-back" href="/#vehiculos"><span class="detail-back-icon" aria-hidden="true">←</span><span>Volver al catálogo</span></a>
        <div id="vehicleLoading" class="detail-loading">Cargando vehículo…</div>
        <div id="vehicleError" class="detail-error" hidden>
          <strong>No encontramos este vehículo.</strong>
          <a href="/#vehiculos">Volver al catálogo</a>
        </div>
        <div id="vehicleContent" hidden>
          <section class="vehicle-detail-hero">
            <div class="vehicle-gallery">
              <div class="gallery-main-wrap">
                <img id="main-image" class="gallery-main" src="/images/placeholder-car.svg" alt="" />
                <span id="galleryCount" class="gallery-count"></span>
                <button class="gallery-arrow gallery-prev" type="button" aria-label="Foto anterior"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 5.5 8 12l6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                <button class="gallery-arrow gallery-next" type="button" aria-label="Foto siguiente"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 5.5 6.5 6.5-6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
              </div>
              <div id="galleryThumbs" class="gallery-thumbs" aria-label="Galería de imágenes"></div>
            </div>
            <aside class="vehicle-summary">
              <div class="vehicle-summary-top"><span id="detailBrand" class="detail-brand"></span><h1 id="detailTitle"></h1><div id="detailFacts" class="detail-keyfacts"></div></div>
              <div class="detail-price-block"><small>PRECIO</small><strong id="detailPrice"></strong></div>
              <div id="detailSummary" class="detail-summary-grid"></div>
              <a id="detailWhatsapp" class="detail-whatsapp" href="#" target="_blank" rel="noreferrer"><svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3.2A12.5 12.5 0 0 0 5.3 22.1L3.7 28.8l6.9-1.8A12.6 12.6 0 1 0 16 3.2Zm0 22.7c-2 0-3.9-.6-5.5-1.6l-.4-.2-4.1 1.1 1.1-4-.3-.4A10.1 10.1 0 1 1 16 25.9Zm5.5-7.6c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.7.1-1.8-.9-3-1.7-4.2-3.8-.3-.5.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.7-.6-.6-.8-.6h-.7c-.2 0-.6.1-.9.4-.3.4-1.2 1.2-1.2 2.9s1.2 3.3 1.4 3.5c.2.2 2.4 3.7 5.9 5.2 2.2.9 3 .9 4.1.8.7-.1 1.8-.7 2.1-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4Z"/></svg>Consultar por WhatsApp</a>
              <p class="detail-help">Consultanos por financiación, toma de usado o para coordinar una visita.</p>
            </aside>
          </section>
          <section id="specDesktop" class="vehicle-specs-desktop"></section>
          <section id="specMobile" class="vehicle-specs-mobile" aria-label="Ficha técnica"></section>
          <section id="similarSection" class="similar-section" aria-labelledby="similar-title" hidden>
            <div class="similar-head"><div><span class="similar-eyebrow">TAMBIÉN TE PUEDE INTERESAR</span><h2 id="similar-title">Vehículos similares</h2></div><a href="/#vehiculos">Ver todo el stock <span aria-hidden="true">→</span></a></div>
            <div id="similarCarousel" class="similar-carousel"></div>
          </section>
        </div>
      </div>
    </main>
    <footer class="site-footer-final traditional-footer">
      <div class="container footer-main">
        <div class="footer-brand-block">
          <img src="/images/logo-lopez.png" alt="Lopez Automotores" class="footer-logo" />
          <div class="footer-socials" aria-label="Redes sociales">
            <a class="social-icon" href="https://www.instagram.com/lopez.automotores5/" target="_blank" rel="noreferrer" aria-label="Instagram"><svg viewBox="0 0 32 32" aria-hidden="true"><rect x="5" y="5" width="22" height="22" rx="7" fill="none" stroke="currentColor" stroke-width="2.8"/><circle cx="16" cy="16" r="5.3" fill="none" stroke="currentColor" stroke-width="2.8"/><circle cx="23.2" cy="8.9" r="1.7" fill="currentColor"/></svg></a>
            <a class="social-icon" href="https://wa.me/543513489872" target="_blank" rel="noreferrer" aria-label="WhatsApp"><svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 4.3A11.5 11.5 0 0 0 6.1 21.6L4.6 27.7l6.2-1.6A11.6 11.6 0 1 0 16 4.3Zm0 20.6c-1.8 0-3.5-.5-5-1.5l-.4-.2-3.6 1 .9-3.5-.2-.4A9.2 9.2 0 1 1 16 24.9Zm5-6.8c-.3-.1-1.6-.8-1.9-.9-.3-.1-.5-.1-.7.2-.2.3-.7.9-.9 1.1-.2.2-.3.2-.6.1-1.6-.8-2.7-1.6-3.8-3.4-.3-.5.3-.5.8-1.5.1-.2 0-.4 0-.6L13 11c-.2-.6-.5-.5-.8-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1.1 1.1-1.1 2.6 0 1.5 1.1 3 1.3 3.2.2.2 2.2 3.4 5.3 4.7 2 .9 2.7.8 3.7.7.6-.1 1.6-.7 1.9-1.4.3-.7.3-1.3.2-1.4-.1-.1-.3-.2-.6-.3Z"/></svg></a>
          </div>
        </div>
        <div class="footer-links-block"><strong>ATAJOS</strong><a href="/#vehiculos">Vehículos</a><a href="/#contacto">Ubicación</a><a href="https://wa.me/543513489872?text=Hola%2C%20quiero%20consultar%20por%20financiaci%C3%B3n." target="_blank" rel="noreferrer">Financiación</a><a href="https://wa.me/543513489872?text=Hola%2C%20quiero%20cotizar%20mi%20usado." target="_blank" rel="noreferrer">Tomamos tu usado</a></div>
        <div class="footer-contact-block"><strong>CONTACTO</strong><a href="https://wa.me/543513489872" target="_blank" rel="noreferrer">+54 9 351 348-9872</a><a href="mailto:lopezautomotoresok@gmail.com">lopezautomotoresok@gmail.com</a><a href="https://www.google.com/maps/search/?api=1&query=R%C3%ADo%20de%20Janeiro%201381%2C%20Villa%20Allende%2C%20C%C3%B3rdoba" target="_blank" rel="noreferrer">Río de Janeiro 1381 · Villa Allende</a></div>
      </div>
      <div class="container footer-bottom"><span>© 2026 Lopez Automotores</span><span>Villa Allende · Córdoba</span></div>
    </footer>

    <script>
      import { supabase } from '../lib/supabase.js';
      const $ = (id) => document.getElementById(id);
      const esc = (value='') => String(value).replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
      const formatPrice = (value) => Number(value)>0 ? new Intl.NumberFormat('es-AR',{style:'currency',currency:'ARS',maximumFractionDigits:0}).format(Number(value)) : 'Consultar precio';
      const formatKm = (value) => value===null||value===undefined ? '—' : `${new Intl.NumberFormat('es-AR').format(Number(value))} km`;
      const shortTransmission = (value='') => { const v=String(value).toLowerCase(); if(v.includes('autom')) return 'Automática'; if(v.includes('manual')) return 'Manual'; return value||'—'; };
      const fullTitle = (v) => [v.modelo,v.version].filter(Boolean).join(' ');
      const vehicleId = new URLSearchParams(location.search).get('id');
      let photos=[]; let current=0;

      function showPhoto(index){ if(!photos.length)return; current=(index+photos.length)%photos.length; $('main-image').src=photos[current]; $('galleryCount').textContent=`${current+1} / ${photos.length}`; document.querySelectorAll('.gallery-thumb').forEach((t,i)=>t.classList.toggle('is-active',i===current)); }
      function renderListCard(title, items){ const arr=Array.isArray(items)?items:[]; if(!arr.length)return ''; return `<div class="spec-card"><div class="spec-title"><h2>${esc(title)}</h2></div><ul>${arr.map(i=>`<li>${esc(i)}</li>`).join('')}</ul></div>`; }
      function renderMobileSpec(title, items, open=false){ const arr=Array.isArray(items)?items:[]; if(!arr.length)return ''; return `<details ${open?'open':''}><summary>${esc(title)} <span>+</span></summary><ul>${arr.map(i=>`<li>${esc(i)}</li>`).join('')}</ul></details>`; }
      function similarScore(a, current){ if(Number(current.precio)>0&&Number(a.precio)>0)return Math.abs(Number(a.precio)-Number(current.precio)); return (a.tipo===current.tipo?0:100000000)+(Math.abs((a.anio||0)-(current.anio||0))*100000); }

      async function loadVehicle(){
        const {data:auto,error}=await supabase.from('vehiculos').select('*').eq('id',vehicleId).eq('publicado',true).eq('vendido',false).maybeSingle();
        $('vehicleLoading').hidden=true;
        if(error||!auto){$('vehicleError').hidden=false; return;}
        document.title=`${auto.marca} ${fullTitle(auto)} | Lopez Automotores`;
        photos=Array.isArray(auto.fotos)&&auto.fotos.length?auto.fotos:['/images/placeholder-car.svg'];
        $('main-image').alt=`${auto.marca} ${fullTitle(auto)}`;
        $('galleryThumbs').innerHTML=photos.map((img,i)=>`<button class="gallery-thumb ${i===0?'is-active':''}" type="button" data-index="${i}" aria-label="Ver foto ${i+1}"><img src="${esc(img)}" alt="" /></button>`).join('');
        $('galleryThumbs').querySelectorAll('.gallery-thumb').forEach(btn=>btn.addEventListener('click',()=>showPhoto(Number(btn.dataset.index))));
        document.querySelector('.gallery-prev')?.addEventListener('click',()=>showPhoto(current-1)); document.querySelector('.gallery-next')?.addEventListener('click',()=>showPhoto(current+1)); showPhoto(0);
        $('detailBrand').textContent=(auto.marca||'').toUpperCase(); $('detailTitle').textContent=fullTitle(auto);
        $('detailFacts').innerHTML=[auto.anio,formatKm(auto.kilometraje),auto.tipo,auto.combustible].filter(Boolean).map(v=>`<span>${esc(v)}</span>`).join('');
        $('detailPrice').textContent=formatPrice(auto.precio);
        const summary=[['Transmisión',shortTransmission(auto.transmision)],['Tracción',auto.traccion||'—'],['Color',auto.color||'—'],['Carrocería',auto.carroceria||auto.tipo||'—']];
        $('detailSummary').innerHTML=summary.map(([k,v])=>`<div><span>${esc(k)}</span><strong>${esc(v)}</strong></div>`).join('');
        const wa=`https://wa.me/543513489872?text=${encodeURIComponent(`Hola, estoy consultando por la ${auto.marca} ${fullTitle(auto)} ${auto.anio||''} que vi en la web.`)}`; $('detailWhatsapp').href=wa; $('headerWhatsapp').href=wa;
        $('specDesktop').innerHTML=renderListCard('Motor y mecánica',auto.motor)+renderListCard('Dimensiones y capacidades',auto.dimensiones)+renderListCard('Confort y tecnología',auto.confort)+renderListCard('Seguridad',auto.seguridad);
        $('specMobile').innerHTML=renderMobileSpec('Motor y mecánica',auto.motor,true)+renderMobileSpec('Dimensiones y capacidades',auto.dimensiones)+renderMobileSpec('Confort y tecnología',auto.confort)+renderMobileSpec('Seguridad',auto.seguridad);
        $('vehicleContent').hidden=false;

        const {data:others}=await supabase.from('vehiculos').select('*').eq('publicado',true).eq('vendido',false).neq('id',auto.id).limit(24);
        const similar=(others||[]).sort((a,b)=>similarScore(a,auto)-similarScore(b,auto)).slice(0,6);
        if(similar.length){ $('similarCarousel').innerHTML=similar.map(v=>{const img=Array.isArray(v.fotos)&&v.fotos[0]?v.fotos[0]:'/images/placeholder-car.svg'; return `<a class="similar-card" href="/vehiculo?id=${encodeURIComponent(v.id)}"><div class="similar-image-wrap"><img src="${esc(img)}" alt="${esc(`${v.marca} ${fullTitle(v)}`)}" />${v.anio?`<span>${esc(v.anio)}</span>`:''}</div><div class="similar-card-body"><small>${esc(v.marca||'')}</small><h3>${esc(fullTitle(v))}</h3><div class="similar-meta"><span>${esc(formatKm(v.kilometraje))}</span><span>${esc(v.tipo||'')}</span></div><strong>${esc(formatPrice(v.precio))}</strong></div></a>`;}).join(''); $('similarSection').hidden=false; }
      }
      loadVehicle();
    </script>
  </body>
</html>
