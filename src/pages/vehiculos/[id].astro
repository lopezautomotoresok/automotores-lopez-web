---
import { autos } from '../../data/autos.js';
import '../../styles/global.css';

export function getStaticPaths() {
  return autos.map((auto) => ({ params: { id: auto.id }, props: { auto } }));
}

const { auto } = Astro.props;
const formatPrice = (value) => value > 0 ? `$${value.toLocaleString('es-AR')}` : 'Consultar precio';
const formatKm = (value) => `${value.toLocaleString('es-AR')} km`;
const shortTransmission = (value = '') => {
  const v = String(value).toLowerCase();
  if (v.includes('autom')) return 'Automática';
  if (v.includes('manual')) return 'Manual';
  return value;
};
const whatsapp = `https://wa.me/543513489872?text=${encodeURIComponent(`Hola, estoy consultando por la ${auto.marca} ${auto.modelo} ${auto.anio} que vi en la web.`)}`;
const similarAutos = autos
  .filter((item) => item.id !== auto.id)
  .sort((a, b) => {
    if (auto.precio > 0 && a.precio > 0 && b.precio > 0) {
      return Math.abs(a.precio - auto.precio) - Math.abs(b.precio - auto.precio);
    }
    const aType = a.tipo === auto.tipo ? 0 : 1;
    const bType = b.tipo === auto.tipo ? 0 : 1;
    if (aType !== bType) return aType - bType;
    return Math.abs(a.anio - auto.anio) - Math.abs(b.anio - auto.anio);
  })
  .slice(0, 6);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${auto.marca} ${auto.modelo} ${auto.anio} - Lopez Automotores, Villa Allende.`} />
    <meta name="theme-color" content="#0a0a0b" />
    <title>{auto.marca} {auto.modelo} | Lopez Automotores</title>
  </head>
  <body>
    <header class="site-header vehicle-header">
      <div class="container nav">
        <a class="brand-logo" href="/" aria-label="Lopez Automotores">
          <img src="/images/logo-lopez.png" alt="Lopez Automotores" />
        </a>

        <nav class="navlinks" aria-label="Navegación principal">
          <a href="/#vehiculos">Vehículos</a>
          <a href="https://wa.me/543513489872?text=Hola%2C%20quiero%20consultar%20por%20opciones%20de%20financiaci%C3%B3n." target="_blank" rel="noreferrer">Financiación</a>
          <a href="https://wa.me/543513489872?text=Hola%2C%20quiero%20consultar%20por%20entregar%20mi%20veh%C3%ADculo%20como%20parte%20de%20pago." target="_blank" rel="noreferrer">Vendé tu auto</a>
          <a href="/#contacto">Contacto</a>
        </nav>

        <a class="button button-small header-whatsapp" href={whatsapp} target="_blank" rel="noreferrer" aria-label="WhatsApp">
          <svg class="whatsapp-mark" viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3.2A12.5 12.5 0 0 0 5.3 22.1L3.7 28.8l6.9-1.8A12.6 12.6 0 1 0 16 3.2Zm0 22.7c-2 0-3.9-.6-5.5-1.6l-.4-.2-4.1 1.1 1.1-4-.3-.4A10.1 10.1 0 1 1 16 25.9Zm5.5-7.6c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.7.1-1.8-.9-3-1.7-4.2-3.8-.3-.5.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.7-.6-.6-.8-.6h-.7c-.2 0-.6.1-.9.4-.3.4-1.2 1.2-1.2 2.9s1.2 3.3 1.4 3.5c.2.2 2.4 3.7 5.9 5.2 2.2.9 3 .9 4.1.8.7-.1 1.8-.7 2.1-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4Z"/></svg>
        </a>
      </div>
    </header>

    <main class="vehicle-detail-page">
      <div class="container detail-shell">
        <a class="detail-back" href="/#vehiculos"><span class="detail-back-icon" aria-hidden="true">←</span><span>Volver al catálogo</span></a>

        <section class="vehicle-detail-hero">
          <div class="vehicle-gallery">
            <div class="gallery-main-wrap">
              <img id="main-image" class="gallery-main" src={auto.imagenes[0]} alt={`${auto.marca} ${auto.modelo}`} />
              <span class="gallery-count">1 / {auto.imagenes.length}</span>
              <button class="gallery-arrow gallery-prev" type="button" aria-label="Foto anterior"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 5.5 8 12l6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
              <button class="gallery-arrow gallery-next" type="button" aria-label="Foto siguiente"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 5.5 6.5 6.5-6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="gallery-thumbs" aria-label="Galería de imágenes">
              {auto.imagenes.map((img, i) => (
                <button class={`gallery-thumb ${i === 0 ? 'is-active' : ''}`} type="button" data-src={img} data-index={i} aria-label={`Ver foto ${i + 1}`}>
                  <img src={img} alt="" />
                </button>
              ))}
            </div>
          </div>

          <aside class="vehicle-summary">
            <div class="vehicle-summary-top">
              <span class="detail-brand">{auto.marca.toUpperCase()}</span>
              <h1>{auto.modelo}</h1>
              <div class="detail-keyfacts">
                <span>{auto.anio}</span>
                <span>{formatKm(auto.km)}</span>
                <span>{auto.tipo}</span>
                <span>{auto.combustible}</span>
              </div>
            </div>

            <div class="detail-price-block">
              <small>PRECIO</small>
              <strong>{formatPrice(auto.precio)}</strong>
            </div>

            <div class="detail-summary-grid">
              <div><span>Transmisión</span><strong>{shortTransmission(auto.transmision)}</strong></div>
              <div><span>Tracción</span><strong>{auto.traccion}</strong></div>
              <div><span>Color</span><strong>{auto.color}</strong></div>
              <div><span>Carrocería</span><strong>{auto.carroceria}</strong></div>
            </div>

            <a class="detail-whatsapp" href={whatsapp} target="_blank" rel="noreferrer">
              <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3.2A12.5 12.5 0 0 0 5.3 22.1L3.7 28.8l6.9-1.8A12.6 12.6 0 1 0 16 3.2Zm0 22.7c-2 0-3.9-.6-5.5-1.6l-.4-.2-4.1 1.1 1.1-4-.3-.4A10.1 10.1 0 1 1 16 25.9Zm5.5-7.6c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.7.1-1.8-.9-3-1.7-4.2-3.8-.3-.5.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.7-.6-.6-.8-.6h-.7c-.2 0-.6.1-.9.4-.3.4-1.2 1.2-1.2 2.9s1.2 3.3 1.4 3.5c.2.2 2.4 3.7 5.9 5.2 2.2.9 3 .9 4.1.8.7-.1 1.8-.7 2.1-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4Z"/></svg>
              Consultar por WhatsApp
            </a>

            <p class="detail-help">Consultanos por financiación, toma de usado o para coordinar una visita.</p>
          </aside>
        </section>

        <section class="vehicle-specs-desktop">
          <div class="spec-card">
            <div class="spec-title"><h2>Motor y mecánica</h2></div>
            <ul>{auto.motor.map(item => <li>{item}</li>)}</ul>
          </div>
          <div class="spec-card">
            <div class="spec-title"><h2>Dimensiones y capacidades</h2></div>
            <ul>{auto.dimensiones.map(item => <li>{item}</li>)}</ul>
          </div>
          <div class="spec-card">
            <div class="spec-title"><h2>Confort y tecnología</h2></div>
            <ul>{auto.confort.map(item => <li>{item}</li>)}</ul>
          </div>
          <div class="spec-card">
            <div class="spec-title"><h2>Seguridad</h2></div>
            <ul>{auto.seguridad.map(item => <li>{item}</li>)}</ul>
          </div>
        </section>

        <section class="vehicle-specs-mobile" aria-label="Ficha técnica">
          <details open><summary>Motor y mecánica <span>+</span></summary><ul>{auto.motor.map(item => <li>{item}</li>)}</ul></details>
          <details><summary>Dimensiones y capacidades <span>+</span></summary><ul>{auto.dimensiones.map(item => <li>{item}</li>)}</ul></details>
          <details><summary>Confort y tecnología <span>+</span></summary><ul>{auto.confort.map(item => <li>{item}</li>)}</ul></details>
          <details><summary>Seguridad <span>+</span></summary><ul>{auto.seguridad.map(item => <li>{item}</li>)}</ul></details>
        </section>
        {similarAutos.length > 0 && (
          <section class="similar-section" aria-labelledby="similar-title">
            <div class="similar-head">
              <div>
                <span class="similar-eyebrow">TAMBIÉN TE PUEDE INTERESAR</span>
                <h2 id="similar-title">Vehículos similares</h2>
              </div>
              <a href="/#vehiculos">Ver todo el stock <span aria-hidden="true">→</span></a>
            </div>
            <div class="similar-carousel">
              {similarAutos.map((item) => (
                <a class="similar-card" href={`/vehiculos/${item.id}`}>
                  <div class="similar-image-wrap">
                    <img src={item.imagenes?.[0] || '/images/placeholder-car.svg'} alt={`${item.marca} ${item.modelo}`} />
                    <span>{item.anio}</span>
                  </div>
                  <div class="similar-card-body">
                    <small>{item.marca}</small>
                    <h3>{item.modelo}</h3>
                    <div class="similar-meta"><span>{formatKm(item.km)}</span><span>{item.tipo}</span></div>
                    <strong>{formatPrice(item.precio)}</strong>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

      </div>
    </main>

    <footer class="site-footer-final traditional-footer">
      <div class="container footer-main">
        <div class="footer-brand-block">
          <img src="/images/logo-lopez.png" alt="Lopez Automotores" class="footer-logo" />
          <div class="footer-socials" aria-label="Redes sociales">
            <a class="social-icon" href="https://www.instagram.com/lopez.automotores5/" target="_blank" rel="noreferrer" aria-label="Instagram"><svg viewBox="0 0 32 32" aria-hidden="true"><rect x="5" y="5" width="22" height="22" rx="7" fill="none" stroke="currentColor" stroke-width="2.8"/><circle cx="16" cy="16" r="5.3" fill="none" stroke="currentColor" stroke-width="2.8"/><circle cx="23.2" cy="8.9" r="1.7" fill="currentColor"/></svg></a>
            <a class="social-icon" href="https://wa.me/543513489872" target="_blank" rel="noreferrer" aria-label="WhatsApp"><svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 4.3A11.5 11.5 0 0 0 6.1 21.6L4.6 27.7l6.2-1.6A11.6 11.6 0 1 0 16 4.3Zm0 20.6c-1.8 0-3.5-.5-5-1.5l-.4-.2-3.6 1 .9-3.5-.2-.4A9.2 9.2 0 1 1 16 24.9Zm5-6.8c-.3-.1-1.6-.8-1.9-.9-.3-.1-.5-.1-.7.2-.2.3-.7.9-.9 1.1-.2.2-.3.2-.6.1-1.6-.8-2.7-1.6-3.8-3.4-.3-.5.3-.5.8-1.5.1-.2 0-.4 0-.6L13 11c-.2-.6-.5-.5-.8-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1.1 1.1-1.1 2.6 0 1.5 1.1 3 1.3 3.2.2.2 2.2 3.4 5.3 4.7 2 .9 2.7.8 3.7.7.6-.1 1.6-.7 1.9-1.4.3-.7.3-1.3.2-1.4-.1-.1-.3-.2-.6-.3Z"/></svg></a>
          </div>
        </div>
        <div class="footer-links-block"><strong>ATAJOS</strong><a href="/#vehiculos">Vehículos</a><a href="/#contacto">Ubicación</a><a href="https://wa.me/543513489872?text=Hola%2C%20quiero%20consultar%20por%20financiaci%C3%B3n." target="_blank" rel="noreferrer">Financiación</a><a href="https://wa.me/543513489872?text=Hola%2C%20quiero%20cotizar%20mi%20usado." target="_blank" rel="noreferrer">Tomamos tu usado</a></div>
        <div class="footer-contact-block"><strong>CONTACTO</strong><a href="https://wa.me/543513489872" target="_blank" rel="noreferrer">+54 9 351 348-9872</a><a href="mailto:lopezautomotoresok@gmail.com">lopezautomotoresok@gmail.com</a><a href="https://www.google.com/maps/search/?api=1&query=R%C3%ADo%20de%20Janeiro%201381%2C%20Villa%20Allende%2C%20C%C3%B3rdoba" target="_blank" rel="noreferrer">Río de Janeiro 1381 · Villa Allende</a></div>
      </div>
      <div class="container footer-bottom"><span>© 2026 Lopez Automotores</span><span>Villa Allende · Córdoba</span></div>
    </footer>

    <script>
      const main = document.querySelector('#main-image');
      const thumbs = [...document.querySelectorAll('.gallery-thumb')];
      const count = document.querySelector('.gallery-count');
      let current = 0;
      const show = (index) => {
        if (!main || !thumbs.length) return;
        current = (index + thumbs.length) % thumbs.length;
        const thumb = thumbs[current];
        main.src = thumb.dataset.src;
        thumbs.forEach((t, i) => t.classList.toggle('is-active', i === current));
        if (count) count.textContent = `${current + 1} / ${thumbs.length}`;
      };
      thumbs.forEach((thumb, i) => thumb.addEventListener('click', () => show(i)));
      document.querySelector('.gallery-prev')?.addEventListener('click', () => show(current - 1));
      document.querySelector('.gallery-next')?.addEventListener('click', () => show(current + 1));
    </script>
  </body>
</html>
